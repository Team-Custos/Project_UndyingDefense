  m_TableData:
  - m_Id: 24251748352
    m_Localized: "\uCDA9\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 27670106112
    m_Localized: "\uAC15\uD55C \uD0C0\uACA9\uC73C\uB85C \uBAB8\uC758 \uADE0\uD615\uC774
      \uBB34\uB108\uC838 \uC6C0\uC9C1\uC784\uACFC \uACF5\uACA9\uC774 \uB454\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 30719365120
    m_Localized: "1\uCD08 \uB3D9\uC548 \uC774\uB3D9 \uC18D\uB3C4 20%, \uACF5\uACA9
      \uC18D\uB3C4 20% \uAC10\uC18C. \uCD5C\uB300 3\uBC88\uAE4C\uC9C0 \uC2A4\uD0DD\uB41C\uB2E4.
      4\uBC88 \uC2A4\uD0DD\uC2DC \uAE30\uC808 \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 34716536832
    m_Localized: "\uAE30\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 38139088896
    m_Localized: "\uB204\uC801\uB41C \uCDA9\uACA9\uC73C\uB85C \uC815\uC2E0\uC744
      \uC783\uC5B4 \uC7A0\uC2DC \uC544\uBB34 \uD589\uB3D9\uB3C4 \uD560 \uC218 \uC5C6\uAC8C
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 41662304256
    m_Localized: "3\uCD08 \uB3D9\uC548 \uD589\uB3D9 \uBD88\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 46158598144
    m_Localized: "\uCD9C\uD608"
    m_Metadata:
      m_Items: []
  - m_Id: 49346269184
    m_Localized: "\uB0A0\uCE74\uB85C\uC6B4 \uACF5\uACA9\uC5D0 \uC0C1\uCC98\uB97C
      \uC785\uC5B4 \uC9C0\uC18D\uC801\uC73C\uB85C \uCCB4\uB825\uC774 \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50587783168
    m_Localized: "3\uCD08 \uB3D9\uC548 \uCD08\uB2F9 3 \uB370\uBBF8\uC9C0\uB97C \uC785\uD78C\uB2E4.
      \uCD5C\uB300 3\uBC88\uAE4C\uC9C0 \uC2A4\uD0DD\uB41C\uB2E4. \uC2A4\uD0DD\uB9C8\uB2E4
      \uCD08\uB2F9 \uB370\uBBF8\uC9C0 2 \uC99D\uAC00. 4\uBC88 \uC2A4\uD0DD\uC2DC
      \uACFC\uB2E4 \uCD9C\uD608 \uC0C1\uD0DC\uAC00 \uBC1C\uB3D9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51258871808
    m_Localized: "\uACE0\uD1B5"
    m_Metadata:
      m_Items: []
  - m_Id: 51829297152
    m_Localized: "\uADF9\uC2EC\uD55C \uD1B5\uC99D\uC73C\uB85C \uBC29\uC5B4 \uC790\uC138\uAC00
      \uD750\uD2B8\uB7EC\uC838 \uCE58\uBA85\uC801\uC778 \uACF5\uACA9\uC5D0 \uCDE8\uC57D\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 52336807936
    m_Localized: "3\uCD08 \uB3D9\uC548 \uCE58\uBA85\uD0C0\uB97C \uC785\uC744 \uD655\uB960
      30% \uC99D\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 52865290240
    m_Localized: "\uC911\uB3C5"
    m_Metadata:
      m_Items: []
  - m_Id: 54249410560
    m_Localized: "\uB3C5\uC774 \uBAB8\uC5D0 \uD37C\uC838 \uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D
      \uC0DD\uBA85\uB825\uC744 \uAC09\uC544\uBA39\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 54920499200
    m_Localized: "3\uCD08 \uB3D9\uC548 \uCD08\uB2F9 \uCD5C\uB300 \uCCB4\uB825\uC758
      2% \uAC10\uC18C."
    m_Metadata:
      m_Items: []
  - m_Id: 55788720128
    m_Localized: "\uACB0\uBC15"
    m_Metadata:
      m_Items: []
  - m_Id: 56556277760
    m_Localized: "\uBAB8\uC774 \uBB36\uC774\uAC70\uB098 \uC6C0\uC9C1\uC784\uC774
      \uC5B5\uB20C\uB824 \uC77C\uC815 \uC2DC\uAC04 \uC774\uB3D9\uD560 \uC218 \uC5C6\uAC8C
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57135091712
    m_Localized: "2\uCD08\uB3D9\uC548 \uC774\uB3D9\uC774 \uBD88\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 57709711360
    m_Localized: "\uC810\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 59316129792
    m_Localized: "\uBD88\uAE38\uC774 \uC62E\uACA8\uBD99\uC5B4 \uC9C0\uC18D\uC801\uC73C\uB85C
      \uD654\uC5FC \uD53C\uD574\uB97C \uC785\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 59878166528
    m_Localized: "3\uCD08 \uB3D9\uC548 \uCD08\uB2F9 3 \uB370\uBBF8\uC9C0\uB97C \uC785\uD78C\uB2E4.
      \uCD5C\uB300 3\uBC88\uAE4C\uC9C0 \uC2A4\uD0DD\uB41C\uB2E4. 4\uBC88 \uC2A4\uD0DD\uC2DC
      \uC791\uC5F4 \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 60490534912
    m_Localized: "\uC791\uC5F4"
    m_Metadata:
      m_Items: []
  - m_Id: 76563107840
    m_Localized: "\uAC70\uC13C \uBD88\uAE38\uC774 \uBAB8\uC744 \uB4A4\uB36E\uC5B4
      \uD070 \uD654\uC5FC \uD53C\uD574\uB97C \uC785\uACE0 \uC8FC\uBCC0\uC73C\uB85C
      \uBD88\uC528\uB97C \uD37C\uB728\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 77099978752
    m_Localized: "5\uCD08 \uB3D9\uC548 \uCD08\uB2F9 8 \uB370\uBBF8\uC9C0\uB97C \uC785\uD78C\uB2E4.
      50% \uD655\uB960\uB85C 5m \uBC18\uACBD \uC801\uC5D0\uAC8C \uC810\uD654 \uD6A8\uACFC\uAC00
      \uBC1C\uC0DD\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 77670404096
    m_Localized: "\uAC10\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 78710591488
    m_Localized: "\uBC88\uAC1C\uC758 \uAE30\uC6B4\uC774 \uBAB8\uC744 \uD0C0\uACE0
      \uD758\uB7EC \uC815\uC2E0\uC774 \uD754\uB4E4\uB9AC\uACE0 \uC6C0\uC9C1\uC784\uC774
      \uB454\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 79310376960
    m_Localized: "5\uCD08 \uB3D9\uC548 \uBA58\uD0C8\uC774 1 \uAC10\uC18C, \uC774\uB3D9
      \uC18D\uB3C4 20% \uAC10\uC18C."
    m_Metadata:
      m_Items: []
  - m_Id: 79847247872
    m_Localized: "\uC704\uCD95"
    m_Metadata:
      m_Items: []
  - m_Id: 80950349824
    m_Localized: "\uC555\uB3C4\uC801\uC778 \uAE30\uC138\uC5D0 \uB20C\uB824 \uC804\uC758\uB97C
      \uC783\uACE0 \uBC1B\uB294 \uD53C\uD574\uAC00 \uC99D\uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 81428500480
    m_Localized: "5\uCD08 \uB3D9\uC548 \uBC1B\uB294 \uB370\uBBF8\uC9C0 10% \uC99D\uAC00.
      \uCD5C\uB300 3\uBC88\uAE4C\uC9C0 \uC2A4\uD0DD\uB41C\uB2E4. 4\uBC88 \uC2A4\uD0DD\uC2DC
      \uACF5\uD3EC \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 81998925824
    m_Localized: "\uACF5\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 82468687872
    m_Localized: "\uADF9\uC2EC\uD55C \uB450\uB824\uC6C0\uC5D0 \uC0AC\uB85C\uC7A1\uD600
      \uC815\uC2E0\uC774 \uD06C\uAC8C \uD754\uB4E4\uB9AC\uACE0 \uBC29\uC5B4\uAC00
      \uBB34\uB108\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 83404017664
    m_Localized: "5\uCD08 \uB3D9\uC548 \uBC1B\uB294 \uB370\uBBF8\uC9C0 50% \uC99D\uAC00,
      \uBA58\uD0C8\uC774 3 \uAC10\uC18C."
    m_Metadata:
      m_Items: []
  - m_Id: 84007997440
    m_Localized: "\uC57D\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 85090127872
    m_Localized: "5\uCD08 \uB3D9\uC548 \uC8FC\uB294 \uB370\uBBF8\uC9C0 30% \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 84611977216
    m_Localized: "\uAE30\uC6B4\uC774 \uBE60\uC838 \uACF5\uACA9\uC5D0 \uD798\uC744
      \uC2E3\uC9C0 \uBABB\uD558\uACE0 \uC8FC\uB294 \uD53C\uD574\uAC00 \uAC10\uC18C\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85656358912
    m_Localized: "\uBC29\uC5B4\uAD6C \uD30C\uAD34"
    m_Metadata:
      m_Items: []
  - m_Id: 86189035520
    m_Localized: "\uBC29\uC5B4\uAD6C\uAC00 \uC190\uC0C1\uB418\uC5B4 \uBCF8\uB798\uC758
