  - m_Id: 29822009355
    m_Localized: "\uAC00\uC9C0 \uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009356
    m_Localized: "\uC5B5\uC13C \uB098\uBB47\uAC00\uC9C0\uB97C \uCCD0 \uB0B4\uB4EF
      \uB0AB\uC744 \uB4E4\uC5B4 \uC544\uB798\uB85C \uB0B4\uB824\uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009357
    m_Localized: "\uBCA0\uAE30 \uB370\uBBF8\uC9C0 13.5"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009358
    m_Localized: "\uACA8\uB204\uC5B4 \uC3D8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009359
    m_Localized: "\uC228\uC744 \uACE0\uB978 \uB4A4 \uC870\uC900 \uD6C4 \uBAA9\uD45C\uBB3C\uC744
      \uC815\uD655\uD558\uAC8C \uACA8\uB220 \uC800\uACA9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009360
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 18"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009361
    m_Localized: "\uCD94\uC218\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009362
    m_Localized: "\uB0AB\uCC3D\uC744 \uB113\uC9C1\uD558\uAC8C \uD718\uB458\uB7EC
      \uB2F9\uAE30\uBA70 \uB2E4\uC218\uC758 \uC801\uC744 \uBCA4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009363
    m_Localized: "\uBCA0\uAE30 \uB370\uBBF8\uC9C0 27"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009364
    m_Localized: "\uBC29\uD328 \uBC00\uCE58\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009365
    m_Localized: "\uBC29\uD328\uB85C \uC0C1\uB300\uBC29\uC758 \uC6C0\uC9C1\uC784\uC744
      \uB04A\uB4EF\uC774 \uAC15\uD558\uAC8C \uBC00\uC5B4 \uCE5C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009366
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 27"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009367
    m_Localized: "\uC815\uC870\uC900"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009368
    m_Localized: "\uCCB4\uACC4\uC801\uC778 \uAD81\uC220\uC744 \uC775\uD600 \uC801\uC744
      \uC815\uC870\uC900\uD558\uC5EC \uD53C\uD574\uB97C \uC900\uB2E4. \uAE09\uC18C\uB97C
      \uB178\uB824 \uBC29\uC5B4\uAD6C\uB97C \uBB34\uC2DC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009369
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 27, \uBC29\uC5B4 \uC0C1\uC131
      \uBB34\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009370
    m_Localized: "\uC800\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009371
    m_Localized: "\uC801\uC744 \uC815\uD655\uD788 \uC800\uACA9\uD558\uC5EC \uAC15\uB825\uD55C
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009372
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 33.75"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009373
    m_Localized: "\uAD00\uD1B5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009374
    m_Localized: "\uCC3D\uC744 \uAE4A\uC219\uD788 \uCC14\uB7EC \uC801\uC744 \uAD00\uD1B5\uD558\uBA70
      \uC9C1\uC120 \uC0C1\uC758 \uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uB300\uC0C1\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009375
    m_Localized: "\uC9C1\uC120 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uCC0C\uB974\uAE30
      \uB370\uBBF8\uC9C0 37.5"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009376
    m_Localized: "\uACF5\uD3EC\uC758 \uCD94\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009377
    m_Localized: "\uC804\uD22C\uB0AB\uC744 \uD06C\uAC8C \uD718\uB458\uB7EC \uB2F9\uAE30\uBA70
      \uB2E4\uC218\uC758 \uC801\uC744 \uBCA4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009378
    m_Localized: "\uC6D0\uBFD4 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uBCA0\uAE30 \uB370\uBBF8\uC9C0
      28.125"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009379
    m_Localized: "\uB825\uC0AC\uC758 \uBD84\uB178"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009380
    m_Localized: "\uB3C4\uAE68\uBE44 \uBC29\uB9DD\uC774\uCC98\uB7FC \uC0DD\uAE34
      \uB300\uCCA0\uD1F4\uB97C \uC744\uB7EC \uC7A1\uACE0 \uC8FC\uBCC0\uC758 \uC801\uB4E4\uC744
      \uD5A5\uD574 \uD798\uAECF \uD718\uB450\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009381
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 28.125, \uBC29\uC5B4\uAD6C
      \uD30C\uAD34 \uC0C1\uD0DC \uC720\uBC1C 20%"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009382
    m_Localized: "\uAE09\uC18C \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009383
    m_Localized: "\uC57D\uC810\uC778 \uC801\uC758 \uBBF8\uAC04\uC744 \uB178\uB824
      \uCE58\uBA85\uC0C1\uC744 \uC785\uD78C\uB2E4. \uAE09\uC18C\uB97C \uB178\uB824
      \uBC29\uC5B4\uAD6C\uB97C \uBB34\uC2DC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29822009384
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 37.5, \uBC29\uC5B4 \uC0C1\uC131
      \uBB34\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009385
    m_Localized: "\uC720\uD0C4 \uD22C\uCC99"
    m_Metadata:
      m_Items: []
  - m_Id: 29822009386
