  m_TableData:
  - m_Id: 29805232128
    m_Localized: "\uAF34 \uBCA0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620736
    m_Localized: "\uC1E0 \uAF34\uC744 \uBCA0\uB4EF \uB0AB\uC73C\uB85C \uC801\uC758
      \uD558\uB2E8\uC744 \uB04C\uC5B4 \uB2F9\uACA8 \uBCA4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620737
    m_Localized: "\uBCA0\uAE30 \uB370\uBBF8\uC9C0 9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620738
    m_Localized: "\uB9C9 \uC3D8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620739
    m_Localized: "\uD654\uC0B4\uC744 \uC3D8\uC544 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uC628
      \uC801\uC744 \uACF5\uACA9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620740
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 12"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620741
    m_Localized: "\uC7B0 \uCC3D\uC9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620742
    m_Localized: "\uB0AB\uCC3D\uC73C\uB85C \uCC14\uB7EC \uC911\uAC70\uB9AC\uC5D0
      \uC788\uB294 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620743
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 18"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620744
    m_Localized: "\uCCA0\uD1F4\uC9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620745
    m_Localized: "\uC801\uC758 \uC0C1\uB2E8\uBD80\uB97C \uB178\uB9AC\uACE0 \uD798\uAECF
      \uB0B4\uB9AC\uCCD0 \uCDA9\uACA9\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620746
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620747
    m_Localized: "\uB178\uB824\uC11C \uC3D8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620748
    m_Localized: "\uD558\uB098\uC758 \uC801\uC744 \uB178\uB824 \uC2E0\uC911\uD788
      \uD654\uC0B4\uC744 \uB0A0\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620749
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 18"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620750
    m_Localized: "\uC77C\uBC1C \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620751
    m_Localized: "\uC870\uCD1D\uC758 \uD0C4\uC744 \uBC1C\uC0AC\uD558\uC5EC \uC801\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620752
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 27."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620753
    m_Localized: "\uC815\uAD8C \uC9C0\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620754
    m_Localized: "\uB098\uBB34\uC640 \uBC14\uC704\uB85C \uB2E8\uB828\uB41C \uC8FC\uBA39\uC73C\uB85C
      \uC801\uAD70\uC5D0\uAC8C \uBB35\uC9C1\uD55C \uD0C0\uACA9\uC744 \uC785\uD78C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620755
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620756
    m_Localized: "\uBE44\uC218 \uB358\uC9C0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620757
    m_Localized: "\uBE44\uC218\uB97C \uB358\uC838 \uC801\uC5D0\uAC8C \uCC0C\uB974\uAE30
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620758
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 13.5"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620759
    m_Localized: "\uAE4A\uAC8C \uCC0C\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620760
    m_Localized: "\uB300\uC0C1\uC744 \uC815\uD655\uD558\uAC8C \uCC14\uB7EC \uCE58\uBA85\uC801\uC778
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620761
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 25"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620762
    m_Localized: "\uCC38\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620763
    m_Localized: "\uC804\uD22C \uB0AB\uC744 \uCE58\uCF1C\uB4E4\uC5B4 \uB2E8\uC228\uC5D0
      \uB0B4\uB9AC\uCE58\uB4EF \uBAA9\uD45C\uBB3C\uC744 \uAC00\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620764
    m_Localized: "\uBCA0\uAE30 \uB370\uBBF8\uC9C0 18.75"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620765
    m_Localized: "\uBD84\uC1C4 \uC77C\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620766
    m_Localized: "\uC801\uC758 \uC0C1\uB2E8\uBD80\uB97C \uB178\uB9AC\uACE0 \uB300\uCCA0\uD1F4\uC758
      \uBB34\uAC8C\uB97C \uC2E4\uC5B4 \uB0B4\uB9AC\uCCD0 \uBD80\uC11C\uC9C8 \uB4EF\uD55C
      \uCDA9\uACA9\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620767
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 18.75"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620768
    m_Localized: "\uCCA0\uD1F4 \uD0C0\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620769
    m_Localized: "\uCCA0\uD1F4\uC9C8\uC774 \uC219\uB828\uB418\uC5B4 \uB9C8\uCE58
      \uD0C0\uC791\uD558\uB4EF \uACBD\uCF8C\uD558\uACE0 \uBE60\uB974\uAC8C \uCDA9\uACA9\uC744
      \uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620770
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 12.5"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620771
    m_Localized: "\uC9D1\uC911 \uC0AC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620772
    m_Localized: "\uD55C \uBC1C \uD55C \uBC1C \uC9D1\uC911\uC744 \uAE30\uD574 \uC801\uC5D0\uAC8C
      \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620773
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 25"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620774
    m_Localized: "\uC2E0\uC18D \uC7A5\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620775
    m_Localized: "\uD654\uC2B9\uCD1D\uC744 \uB354\uC6B1 \uC19C\uC528\uC788\uAC8C
      \uB2E4\uB904 \uC219\uB828\uB41C \uC19C\uC528\uB85C \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C
      \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620776
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 31.25"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620777
    m_Localized: "\uB3CC\uD48D"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620778
    m_Localized: "\uC2E0\uD1B5\uD55C \uBD80\uCC44\uC9C8\uB85C \uC99D\uD3ED\uC2DC\uD0A8
      \uD68C\uC624\uB9AC\uB97C \uB0A0\uB824 \uC801\uAD70\uC5D0\uAC8C \uCDA9\uACA9\uC744
      \uC8FC\uC5B4 \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29813620779
    m_Localized: "\uC6D0\uBFD4 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uB54C\uB9AC\uAE30
      \uB370\uBBF8\uC9C0 18.75"
    m_Metadata:
      m_Items: []
  - m_Id: 29813620780
    m_Localized: "\uC815\uC2E0\uBD09"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815040
    m_Localized: "\uC801\uAD70\uC744 \uD5A5\uD574 \uBD09\uC744 \uB113\uAC8C \uD718\uB458\uB7EC
      \uBC18\uC131\uC758 \uAE30\uD68C\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815041
    m_Localized: "\uC6D0\uBFD4 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uB54C\uB9AC\uAE30
      \uB370\uBBF8\uC9C0 25, \uC704\uCD95 \uC0C1\uD0DC \uC720\uBC1C 20%"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815042
    m_Localized: "\uC0B4 \uB0A0\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815043
    m_Localized: "\uBB34\uB2F9\uC774 \uC4F0\uB294 \uBB34\uAD6C\uC5D0 \uC545\uC758\uB97C
      \uB2F4\uC544 \uC801\uC5D0\uAC8C \uC0B4\uC744 \uB0A0\uB824 \uD53C\uD574\uB97C
      \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815044
    m_Localized: "\uB3C5 \uB370\uBBF8\uC9C0 18.75"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815045
    m_Localized: "\uB3C5\uCE68 \uCC0C\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815046
    m_Localized: "\uC758\uC57D\uB3C4 \uACFC\uD558\uBA74 \uB3C5\uC774 \uB418\uB294
      \uBC95, \uC790\uC2E0\uC774 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294 \uB0A1\uC740
      \uCE68\uC5D0 \uB3C5\uC744 \uBB3B\uD600 \uC801\uC5D0\uAC8C \uB358\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815047
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 12.5, \uC911\uB3C5 \uC0C1\uD0DC
      \uC720\uBC1C 20%"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815048
    m_Localized: "\uD718\uB3CC\uB824 \uCC0C\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815049
    m_Localized: "\uC804\uBC29\uC758 \uB2E8\uC77C \uC801\uC744 \uD5A5\uD574 \uD718\uB3CC\uB824
      \uCC0C\uB974\uB294 \uB09C\uACA9\uC744 \uAC00\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815050
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 40"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815051
    m_Localized: "\uB300\uCC38\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815052
    m_Localized: "\uAC70\uB300\uD55C \uB0AB\uC744 \uCE58\uCF1C\uB4E4\uC5B4 \uB2E8\uC228\uC5D0
      \uB0B4\uB9AC\uCE58\uB4EF \uBAA9\uD45C\uBB3C\uC744 \uAC00\uB978\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 29817815053
    m_Localized: "\uBCA0\uAE30 \uB370\uBBF8\uC9C0 37.5"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815054
    m_Localized: "\uD30C\uC1C4 \uC77C\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815055
    m_Localized: "\uC801\uC758 \uC0C1\uB2E8\uBD80\uB97C \uB178\uB9AC\uACE0 \uC57C\uCC28\uACFC\uC758
      \uC721\uC911\uD55C \uBB34\uAC8C\uB97C \uC2E4\uC5B4 \uB0B4\uB9AC\uCCD0 \uAC00\uB8E8\uAC00
      \uB420 \uB9CC\uD07C \uD070 \uCDA9\uACA9\uC744 \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815056
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815057
    m_Localized: "\uD575 \uCCA0\uD1F4"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815058
    m_Localized: "\uBB35\uC9C1\uD55C \uCCA0\uAD6C\uB97C \uB2A5\uC219\uD558\uAC8C
      \uC62C\uB838\uB2E4 \uB0B4\uB824\uCE58\uBA70 \uD575 \uAFC0\uBC24\uC744 \uBA39\uC774
      \uB4EF \uD070 \uCDA9\uACA9\uC744 \uC900\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 29817815059
    m_Localized: "\uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0 20"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815060
    m_Localized: "\uC77C\uCD09 \uD544\uC0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815061
    m_Localized: "\uD3C9\uC815 \uC0C1\uD0DC\uB97C \uC720\uC9C0\uD574 \uC9D1\uC911\uD558\uC5EC
      \uD55C \uBC1C \uD55C \uBC1C \uAC15\uB825\uD55C \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815062
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 40"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815063
    m_Localized: "\uC18D\uC0AC\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815064
    m_Localized: "\uADFC\uB300\uD654 \uBB34\uAE30\uB97C \uC0AC\uC6A9\uD574 \uBE60\uB974\uACE0
      \uAC15\uB825\uD558\uAC8C \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815065
    m_Localized: "\uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0 50"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815066
    m_Localized: "\uB3CC\uAC1C\uBC14\uB78C"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815067
    m_Localized: "\uC2E0\uBB18\uD55C \uBD80\uCC44\uC9C8\uB85C \uB09C\uAE30\uB958\uB97C
      \uC99D\uD3ED\uC2DC\uCF1C \uC5EC\uB7EC\uAC1C\uC758 \uB3CC\uAC1C\uBC14\uB78C\uC744
      \uB0B4\uBCF4\uB0B4\uC5B4 \uB2E4\uC218\uC758 \uC801\uC744 \uBCA0\uC5B4 \uD53C\uD574\uB97C
      \uC900\uB2E4.  "
    m_Metadata:
      m_Items: []
  - m_Id: 29817815068
    m_Localized: "\uC6D0\uBFD4 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uBCA0\uAE30 \uB370\uBBF8\uC9C0
      30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815069
    m_Localized: "\uC8FC\uC7A5\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815070
    m_Localized: "\uC8FC\uC7A5\uC790\uB97C \uD718\uB458\uB7EC \uC545\uD55C \uB9C8\uC74C\uC744
      \uAC00\uC9C4 \uC801\uC5D0\uAC8C \uB54C\uB9AC\uAE30 \uD53C\uD574\uB97C \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815071
    m_Localized: "\uC6D0\uBFD4 \uBC94\uC704 \uB0B4 \uC801\uAD70 \uB54C\uB9AC\uAE30
      \uD53C\uD574 40, \uC704\uCD95 \uC0C1\uD0DC \uC720\uBC1C 40%"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815072
    m_Localized: "\uADF9\uC0B4 \uB0A0\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815073
    m_Localized: "\uC545\uD589\uC744 \uC800\uC9C0\uB978 \uC790\uB97C \uBC8C\uD558\uAE30
      \uC704\uD574 \uB354\uC6B1 \uAC15\uB825\uD574\uC9C4 \uD751\uC2EC\uC73C\uB85C
      \uB2E4\uC218\uC758 \uC801\uC5D0\uAC8C \uC0B4\uC744 \uB0A0\uB9AC\uBA70 \uD53C\uD574\uB97C
      \uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815074
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 29817815075
    m_Localized: "\uBAB0\uC544\uCE58\uB294 \uD654\uC5FC"
    m_Metadata:
      m_Items: []
  - m_Id: 29817815076
    m_Localized: "\uD654\uC5FC\uC744 \uD30C\uB3C4\uCC98\uB7FC \uC77C\uC73C\uCF1C
      \uB2E4\uC218\uC758 \uC801\uC744 \uBD88\uD0DC\uC6B4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 29817815077
