  m_TableData:
  - m_Id: 30446960640
    m_Localized: "\uC7A5\uAD70, \uC870\uAE08 \uC804 \uADFC\uCC98\uC5D0 \uC5B4\uB290
      \uC804\uB839\uC774 \uD3EC\uACE0\uD558\uBA70 \uC758\uB839\uC758 \uBD89\uC740\uCCA0\uB9AD
      \uCC9C\uAC15\uC774\uB77C\uB294 \uC758\uBCD1\uC7A5\uC758 \uACA9\uBB38\uC744
      \uB0AD\uB3C5\uD558\uC600\uB294\uB370 \uB9D0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 30451154944
    m_Localized: "\"\uB098\uB77C\uAC00 \uC704\uD0DC\uB85C\uC6B0\uB2C8 \uC758\uB85C\uC6B4
      \uC790\uC5EC \uC77C\uC5B4\uB098\uB77C! \n\uAD00\uAD70\uC774 \uBB34\uB825\uD558\uAC8C
      \uBB34\uB108\uC838 \uBC31\uC131\uC740 \uC624\uAC08 \uB370 \uC5C6\uACE0\n\uC758\uB839\uC740
      \uCE68\uB7B5\uC790\uB4E4\uC758 \uC8FC\uC694\uD55C \uC9C4\uAD70\uB85C\uB77C\n\uC5B4\uCC0C
      \uC8FD\uC74C\uC73C\uB85C\uC11C \uC0AC\uC218\uD558\uC9C0 \uC54A\uC744 \uC218
      \uC788\uACA0\uB294\uAC00?\""
    m_Metadata:
      m_Items: []
  - m_Id: 30451154945
    m_Localized: "\"\uC758(\u7FA9)\uB294 \uD558\uB298\uC774 \uB0B4\uB9B0 \uCE7C\uC774\uB2C8,
      \n\uB450\uB824\uC6C0\uC5C6\uC774 \uC751\uD558\uC5EC \uC9D1\uACB0\uD558\uB77C!\""
    m_Metadata:
      m_Items: []
  - m_Id: 30451154946
    m_Localized: "\uC774\uB7EC\uD55C \uB0B4\uC6A9\uC774\uC628\uB370, \uC5B4\uCC0C\uD560\uAE4C\uC694?
      \uC77C\uB2E8 \uC6C0\uC9C1\uC77C \uCC28\uBE44\uB294 \uD574\uB450\uC5C8\uC73C\uB2C8
      \uC7A5\uAD70\uAED8\uC11C \uC6A9\uB2E8\uB9CC \uB0B4\uB9AC\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
