%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UnitStringData(Name, Description)_ko-KR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: d353da8880899394da8cc45b97dbe901, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 28433694720
    m_Localized: "\uB18D\uC0AC\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083328
    m_Localized: "\"\uC6B0\uB9AC \uD6C4\uC190\uB4E4\uC774 \uC0B4\uC544\uAC08 \uB545\uC740
      \uB0B4 \uC190\uC73C\uB85C \uC9C0\uD0AC\uAC81\uB2C8\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083329
    m_Localized: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC678\uC138\uC758 \uCE68\uB7B5\uC73C\uB85C
      \uD130\uC804\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574 \uB18D\uAE30\uAD6C\uB97C
      \uB4E4\uACE0 \uCC38\uC804\uD55C \uC6A9\uAE30\uC788\uB294 \uC790\uB4E4. \uD6C8\uB828\uC744
      \uBC1B\uC9C0\uB294 \uC54A\uC558\uC9C0\uB9CC \uC624\uB79C \uB18D\uC0AC\uC77C\uB85C
      \uB2E8\uB828\uB41C \uCCB4\uB825\uACFC \uB048\uAE30\uAC00 \uD2B9\uC9D5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083330
    m_Localized: "\uC0AC\uB0E5\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083331
    m_Localized: "\u201C\uC0B0\uC9D0\uC2B9\uB3C4 \uC81C \uC601\uC5ED\uC740 \uBAA9\uC228
      \uAC78\uACE0 \uC9C0\uD0A4\uB294 \uBC95\uC774\uAC70\uB4E0.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083332
    m_Localized: "\uC0AC\uB0E5\uC73C\uB85C \uB2E4\uC838\uC9C4 \uD65C \uC19C\uC528\uB85C
      \uC6C0\uC9C1\uC774\uB294 \uBAA9\uD45C\uB77C\uB3C4 \uB9DE\uCD9C\uC218 \uC788\uAC8C
      \uD654\uC0B4\uC744 \uB0A0\uB9B0\uB2E4. \uC0AC\uB0E5\uD130\uB97C \uAC15\uD0C8\uD558\uB294
      \uCE68\uB7B5\uC790\uB4E4\uC5D0 \uB9DE\uC11C \uC2F8\uC6B0\uAE30 \uC704\uD574
      \uC758\uBCD1\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083333
    m_Localized: "\uB0AB\uCC3D\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083334
    m_Localized: "\u201C\uC9C0\uAE08\uAE4C\uC9C0 \uBCA0\uC5B4 \uB0B8 \uC1E0\uAF34\uB9CC
      \uD574\uB3C4 \uC0B0 \uD558\uB098 \uB9CC\uB4E4\uACE0 \uB0A8\uC9C0\uC694!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083335
    m_Localized: "\uCC3D \uB05D\uC5D0 \uB0AB\uC744 \uB2EC\uC544 \uAC1C\uB7C9\uD55C
      \uB0AB\uCC3D\uC740 \uACF5\uBC29\uC774 \uC218\uC6D4\uD558\uC9C0\uB9CC, \uB2E8\uB828\uB41C
      \uBAB8\uC774 \uC544\uB2C8\uACE0\uC11C\uB294 \uBAB8\uC0B4\uC774 \uB0A0 \uC815\uB3C4\uB85C
      \uC0AC\uC6A9 \uB09C\uC774\uB3C4\uAC00 \uB192\uB2E4. \uBBFC\uCCA9\uD558\uAC8C
      \uCC0C\uB974\uACE0 \uBCA0\uB294 \uC2E4\uB825\uC774 \uC77C\uCDE8\uC6D4\uC7A5\uD558\uB294
      \uC911\uC774\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 28442083336
    m_Localized: "\uB3CC\uACA9\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083337
    m_Localized: "\u201C\uB0B4\uAC00 \uC120\uBD09\uC5D0 \uC124\uD14C\uB2C8 \uC5C4\uD638\uD574\uC8FC\uC2DC\uC624!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083338
    m_Localized: "\uB0AB \uB300\uC2E0 \uBC29\uD328\uB97C \uB4E4\uC5B4 \uB3D9\uB8CC\uB97C
      \uC9C0\uD0A4\uB294 \uC790\uB4E4. \uBC29\uD328\uC640 \uCCA0\uD1F4\uB97C \uB4E4\uACE0
      \uAC70\uCE68\uC5C6\uC774 \uB3CC\uACA9\uD574 \uC801 \uC9C4\uC601\uC744 \uBB34\uB108\uB728\uB9AC\uB294
      \uB300\uB2F4\uD568\uC744 \uC9C0\uB154\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083339
    m_Localized: "\uAD81\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083340
    m_Localized: "\u201C\uD654\uC0B4 \uD558\uB098\uC5D0 \uC801\uAD70 \uD558\uB098.
      \uC77C\uC2DC\uCC9C\uAE08 \uCC9C\uC2DC\uC5EC\uC0C1\uC785\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083341
    m_Localized: "\uC0AC\uB0E5\uC744 \uD558\uB358 \uAC01\uAC1C\uC804\uD22C \uAD81\uC220\uC5D0
      \uCCB4\uACC4\uC801\uC778 \uD6C8\uB828\uC744 \uB354\uD574 \uC218\uC131 \uBCD1\uBC95\uC744
      \uC2B5\uB4DD\uD558\uC600\uB2E4. \uC5B4\uB5A4 \uC0C1\uD669\uC5D0\uC11C\uB3C4
      \uC2E0\uC911\uD568\uC744 \uC720\uC9C0\uD558\uBA70 \uC9C0\uD718\uD1B5\uC194\uC5D0
      \uB9DE\uCD94\uC5B4 \uBAA9\uD45C\uBB3C\uC744 \uBA85\uC911\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083342
    m_Localized: "\uD3EC\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083343
    m_Localized: "\u201C\uCC98\uC74C\uC5D4 \uBC29\uD3EC\uC18C\uB9AC\uC5D0 \uB180\uB790\uB294\uB370
      \uC774\uC820 \uD638\uB7AD\uC774\uB3C4 \uC7A1\uACA0\uB124\uC694\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083344
    m_Localized: "\uC7AC\uC8FC\uAFBC\uC778 \uC0AC\uB0E5\uAFBC\uC5D0\uAC8C \uC2E0\uC2DD
      \uBB34\uAE30\uC778 \uD654\uC2B9\uCD1D\uC740 \uB610 \uB2E4\uB978 \uAC00\uB2A5\uC131\uC744
      \uC5F4\uC5B4\uC92C\uB2E4. \uC544\uC9C1\uC740 \uC5F4\uC2EC\uD788 \uC7A5\uC804\uD558\uB290\uB77C
      \uC5EC\uB150\uC774 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083345
    m_Localized: "\uC218\uD589\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083346
    m_Localized: "\"\uC2E4\uCC9C\uD558\uC9C0 \uC54A\uB294 \uC218\uD589\uC740 \uC758\uBBF8\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083347
    m_Localized: "\uAE4A\uC740 \uC0B0\uC18D\uC5D0 \uC740\uC2E0\uD574 \uC218\uB828\uD558\uB358
      \uC774\uB4E4\uC774 \uC758\uBCD1\uC5D0 \uC9C0\uC6D0\uD588\uB2E4. \uB9E8\uC190\uC73C\uB85C
      \uAE08\uAC15\uC0B0 \uD638\uB791\uC774\uB97C \uB54C\uB824\uC7A1\uC558\uB2E4\uB294
      \uC18C\uBB38\uC774 \uC788\uB2E4. \uADFC\uC811\uC804\uC5D0\uC11C \uAC15\uB825\uD55C
      \uD798\uC744 \uBC1C\uD718\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083348
    m_Localized: "\uAE30\uB140"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083349
    m_Localized: "\"\uBB50\uB77C\uB3C4 \uB3C4\uC6B8 \uAC8C \uC788\uC744\uAE4C \uD574\uC11C\uC694.
      \uD765\uC744 \uB3CB\uC6B0\uB294 \uC7AC\uC8FC\uB294 \uC788\uC0AC\uC635\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083350
    m_Localized: "\uAE30\uC608\uAC00 \uB6F0\uC5B4\uB098\uACE0 \uD48D\uB958\uB97C
      \uC798 \uC544\uB294 \uC608\uC220\uAC00 \uC911\uC5D0\uC11C \uC758\uBCD1\uC5D0
      \uC790\uC6D0\uD55C \uC774. \uC544\uB984\uB2E4\uC6B4 \uC608\uC778\uC774\uB77C\uACE0
      \uB9CC\uB9CC\uD558\uAC8C \uBCF4\uC558\uB2E4\uAC00\uB294 \uD070 \uD654\uB97C
      \uB2F9\uD560 \uC218\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083351
    m_Localized: "\uC7A5\uCC3D\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083352
    m_Localized: "\u201C\uD55C \uBC1C\uC790\uAD6D\uC774\uB77C\uB3C4 \uB2E4\uAC00\uC628\uB2E4\uBA74
      \uC0B4\uC544\uB0A8\uC9C0 \uBABB\uD560 \uAC83\uC774\uB2E4!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083353
    m_Localized: "\uC7A5\uCC3D\uC758 \uAE34 \uC0AC\uAC70\uB9AC\uB97C \uC774\uC6A9\uD574
      \uB2E4\uAC00\uC624\uB294 \uC801\uC5D0\uAC8C \uCE58\uBA85\uC801\uC778 \uD53C\uD574\uB97C
      \uC900\uB2E4. \uCC3D\uC774 \uD53C\uD574\uB97C \uC904 \uB54C \uC801\uC774 \uAD6C\uCD95\uD55C
      \uC9C4\uD615\uC774 \uBB34\uB108\uC9C0\uAE30\uB3C4 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083354
    m_Localized: "\uB300\uACB8\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083355
    m_Localized: "\u201C\uC790\uBE44\uB85C\uC6C0\uC740 \uC800 \uB140\uC11D\uB4E4\uC5D0\uAC90
      \uC0AC\uCE58\uC77C \uBFD0\uC774\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083356
    m_Localized: "\uB0A0\uCE74\uB85C\uC6C0\uACFC \uBB35\uC9C1\uD55C \uC704\uB825\uC744
      \uB3D9\uC2DC\uC5D0 \uAC00\uC9C4 \uC804\uD22C\uB0AB\uC744 \uB2E4\uB8E8\uB294
      \uC790. \uC804\uC7A5\uC5D0\uC11C\uB294 \uC804\uD22C\uB0AB\uC744 \uD718\uB458\uB7EC
      \uB113\uC740 \uADA4\uB3C4\uB85C \uC801\uC744 \uAC00\uCC28\uC5C6\uC774 \uBCA0\uC5B4\uB0B4
      \uC801\uC758 \uC811\uADFC\uC744 \uD5C8\uB77D\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083357
    m_Localized: "\uD30C\uC1C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083358
    m_Localized: "\u201C\uC644\uB825\uC774\uB77C\uBA74 \uB098\uC640 \uACAC\uC904
      \uC790\uAC00 \uC5C6\uC9C0. \uD55C\uBC88 \uACA8\uB904\uBCF4\uC2DC\uAC8C?\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083359
    m_Localized: "\uBC14\uC704\uB97C \uC62E\uAE30\uACE0 \uD1B5\uB098\uBB34\uB97C
      \uB098\uB974\uBA70 \uD798\uC744 \uAE38\uB7EC\uC628 \uC7A5\uC0AC. \uC804\uC7A5\uC5D0\uC11C\uB294
      \uB3CC\uACA9\uB300\uC758 \uB9DD\uCE58\uAC00 \uB418\uC5B4 \uC801 \uC9C4\uD615\uC744
      \uBB34\uB108\uB728\uB9B0\uB2E4. \uC2B9\uBD80\uC695\uC774 \uAC15\uD574 \uC27D\uAC8C
      \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083360
    m_Localized: "\uBC29\uC9C4\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083361
    m_Localized: "\u201C\uC4F0\uB7EC\uC9C8\uC9C0\uC5B8\uC815 \uBB3C\uB7EC\uC11C\uC9C4
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083362
    m_Localized: "\uAE34 \uC7A5\uBC29\uD328\uB85C \uB3D9\uB8CC\uB4E4\uC744 \uAC10\uC2F8\uB294
      \uCCA0\uBCBD \uAC19\uC740 \uC874\uC7AC\uB2E4. \uC544\uBB34\uB9AC \uB9CE\uC740
      \uC801\uC774 \uBAB0\uB824\uC640\uB3C4 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uACE0,
      \uBB35\uBB35\uD788 \uBC29\uC5B4 \uC9C4\uC601\uC744 \uAD6C\uCD95\uD574 \uB3D9\uB8CC\uB97C
      \uBCF4\uD638\uD574\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083363
    m_Localized: "\uBA85\uAD81"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083364
    m_Localized: "\u201C\uBC14\uB78C\uC740 \uACC4\uC0B0\uD558\uB294 \uAC8C \uC544\uB2C8\uB77C
      \uADF9\uBCF5\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083365
    m_Localized: "\uAD81\uC218 \uC911 \uBC31\uBC1C\uBC31\uC911\uC778 \uC790\uB4E4\uC740
      \uBA85\uAD81\uC774\uB77C\uB294 \uD638\uCE6D\uC73C\uB85C \uBD88\uB9B0\uB2E4.
      \uC804\uC7A5\uC5D0\uC11C\uB294 \uC800\uACA9\uC744 \uD1B5\uD574 \uC804\uC138\uB97C
      \uC5ED\uC804\uC2DC\uD0A4\uBA70 \uC5FC\uC9C1\uACFC\uAC10\uC744 \uC2E4\uCC9C\uD558\uC5EC
      \uC8FC\uBCC0\uC758 \uADC0\uAC10\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083366
    m_Localized: "\uBA85\uD3EC\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083367
    m_Localized: "\u201C\uBC1C\uC790\uAD6D \uC18C\uB9AC\uB85C \uAC70\uB9AC\uB97C
      \uAC00\uB2A0\uD558\uACE0 \uC801\uB2F9\uD55C \uB54C \uACA9\uBC1C\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083368
    m_Localized: "\uC774\uC81C\uB294 \uBE60\uB974\uAC8C \uC7A5\uC804\uD558\uACE0
      \uAC00\uC7A5 \uC801\uB2F9\uD55C \uB54C\uC5D0 \uC3D8\uC544 \uCE58\uBA85\uC0C1\uC744
      \uC785\uD788\uB294 \uACBD\uC9C0\uC5D0 \uC774\uB974\uB800\uB2E4.  \uC720\uD0C4\uC744
      \uD65C\uC6A9\uD574 \uC804\uC138\uB97C \uC5ED\uC804\uC2DC\uD0A4\uAE30\uB3C4
      \uD55C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 28442083369
    m_Localized: "\uB3C4\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083370
    m_Localized: "\"\uBB34\uADF9\uACFC \uD0DC\uADF9, \uD558\uB298\uACFC \uB545\uACFC
      \uC0AC\uB78C\uC774 \uB9CC\uB098 \uC5ED\uB3D9\uD55C\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083371
    m_Localized: "\uC218\uD589\uC744 \uD1B5\uD574 \uC790\uC5F0\uC758 \uC774\uCE58\uB97C
      \uAE68\uB2EB\uACE0 \uC2E0\uBB18\uD55C \uB3C4\uC220\uC744 \uC5F0\uB9C8\uD588\uB2E4.
      \uBD80\uCC44\uB97C \uD718\uC800\uC5B4 \uBC14\uB78C\uC744 \uC77C\uC73C\uD0A4\uBA74
      \uB098\uBE44\uD6A8\uACFC\uB85C \uC19F\uC744\uBC14\uB78C\uC774 \uB418\uACE0
      \uD0DC\uD48D\uC774\uB418\uB294 \uC6D0\uB9AC\uB97C \uC0AC\uB78C\uB4E4\uC740
      \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083372
    m_Localized: "\uC2B9\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083373
    m_Localized: "\"\uC9C0\uC7A5 \uBCF4\uC0B4\uC758 \uB9C8\uC74C\uC73C\uB85C \uC120\uB7C9\uD55C
      \uC911\uC0DD\uB4E4\uC744 \uAD6C\uD558\uC790!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083374
    m_Localized: "\uBD80\uCC98\uC758 \uAE68\uB2EC\uC74C\uC744 \uC5BB\uACE0\uC790
      \uC815\uC9C4\uD558\uC5EC \uC654\uC73C\uB098 \uC774 \uB545\uC758 \uD3C9\uD654\uC640
      \uBC31\uC131\uB4E4\uC744 \uC9C0\uD0A4\uACE0\uC790 \uC2A4\uC2A4\uB85C \uD30C\uACC4\uD558\uC5EC
      \uC0AC\uCC9C\uC655\uCC98\uB7FC \uC0B4\uC0DD\uC758 \uC0AC\uBA85\uC744 \uB2E4\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083375
    m_Localized: "\uBB34\uB2F9"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083376
    m_Localized: "\"\uB108\uD76C\uAC00 \uC800\uC9C0\uB978 \uC8C4\uC545, \uC774 \uB545\uC758
      \uC2E0\uB839\uB4E4\uC774 \uC6A9\uC11C\uCE58 \uC54A\uC744 \uAC83\uC774\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083377
    m_Localized: "\uBCF4\uC774\uC9C0 \uC54A\uB294 \uAC83\uC744 \uBCF4\uACE0 \uB4E4\uB9AC\uC9C0
      \uC54A\uB294 \uAC83\uC744 \uB4E3\uB294 \uC2E0\uACFC \uC778\uAC04 \uC0AC\uC774\uC758
      \uC601\uB9E4. \uCE68\uB7B5\uC790\uB4E4\uC758 \uD0D0\uC695\uC2A4\uB7F0 \uAE30\uC6B4\uC774
      \uB290\uAEF4\uC9C0\uBA74 \uB9DD\uC124\uC784 \uC5C6\uC774 \uC8FC\uBB38 \uACF5\uACA9\uC744
      \uB0A0\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083378
    m_Localized: "\uC758\uB140"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083379
    m_Localized: "\"\uCE68\uC73C\uB85C \uCE58\uB8CC\uB3C4 \uD558\uACE0 \uACF5\uACA9\uB3C4
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB193\uB294 \uC790\uB9AC\uB9CC \uB2E4\uB97C
      \uBFD0\uC774\uC8E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083380
    m_Localized: "\uCE68\uC220\uACFC \uC57D\uCD08\uD559\uC5D0 \uC815\uD1B5\uD55C
      \uC774\uB4E4. \uB3C5\uCE68\uC73C\uB85C \uC801\uC744 \uB9C9\uACE0 \uC57D\uC73C\uB85C
      \uC544\uAD70\uC744 \uCE58\uB8CC\uD558\uAE30 \uC704\uD574 \uC804\uC120\uC5D0
      \uC9C1\uC811 \uB098\uC130\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083381
    m_Localized: "\uB0AD\uC120\uCC28\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083382
    m_Localized: "\"\uC544\uBB34\uB9AC \uB2E8\uB2E8\uD55C \uC9C4\uD615\uC774\uB77C\uB3C4
      \uB0B4 \uB0AD\uC120\uCC3D \uC55E\uC5D0\uC120 \uC18D\uC218\uBB34\uCC45\uC77C
      \uBFD0\uC785\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083383
    m_Localized: "\uB0AD\uC120\uCC28\uC0AC\uB294 \uBFB0\uC871\uD55C \uCD09\uC744
      \uCE58\uB801\uD558\uAC8C \uB9E4\uB2E8 \uB0AD\uC120\uCC3D\uC744 \uD718\uC800\uC73C\uBA70
      \uC801\uC9C4\uC73C\uB85C \uB3CC\uC9C4\uD55C\uB2E4. \uACAC\uACE0\uD55C \uBC29\uC9C4\uC774\uB77C
      \uD560\uC9C0\uB77C\uB3C4 \uBE60\uB974\uAC8C \uBB34\uB108\uB728\uB9AC\uB294
      \uAC83\uC774 \uD2B9\uAE30\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083384
    m_Localized: "\uCD94\uD63C\uC0AC\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083385
    m_Localized: "\"\uB354 \uC774\uC0C1\uC758 \uCE68\uB7B5\uC740 \uD5C8\uC6A9\uD558\uC9C0
      \uC54A\uACA0\uB2E4. \uB124 \uB188\uB4E4\uC758 \uC601\uD63C\uC744 \uAC70\uB450\uC5B4\uC8FC\uB9C8...\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083386
    m_Localized: "\uAC70\uB300\uD55C \uB0AB\uC744 \uB4E0 \uCD94\uD63C\uCC28\uC0AC\uB294
      \uC801\uC5D0\uAC8C \uC804\uC7A5\uC758 \uC800\uC2B9\uC0AC\uC790\uB85C \uBD88\uB9AC\uC6B4\uB2E4.
      \uACF5\uD3EC\uC2A4\uB7EC\uC6B4 \uC0AC\uC790\uACB8\uC744 \uBB34\uC790\uBE44\uD558\uAC8C
      \uD718\uB458\uB7EC \uC801\uB4E4\uC744 \uD669\uCC9C\uC73C\uB85C \uC778\uB3C4\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083387
    m_Localized: "\uCCA9\uC911\uD30C\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083388
    m_Localized: "\u201C\uD0DC\uC0B0\uAC19\uC740 \uBC29\uD328\uB77C\uB3C4 \uB0B4
      \uC57C\uCC28\uACFC\uB97C \uBC84\uD2F8 \uC218 \uC788\uB294 \uC9C0 \uB450\uACE0\uBCF4\uC790\uACE0!\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083389
    m_Localized: "\uAC70\uB300\uD55C \uCCA0\uD1F4\uB97C \uC7A5\uB09C\uAC10 \uB2E4\uB8E8\uB4EF
      \uD718\uB450\uB974\uB294 \uC790\uB4E4\uB85C \uD638\uBC29\uD558\uACE0 \uB300\uBC94\uD55C
      \uC131\uD488\uC744 \uC9C0\uB2CC \uB300\uC7A5\uBD80\uC774\uB2E4. \uBB34\uC2DC\uBB34\uC2DC\uD55C
      \uC57C\uCC28\uACFC\uB97C \uB0B4\uB9AC\uCE60 \uB54C\uB9C8\uB2E4 \uC801\uC758
      \uBAB8\uC740 \uC73C\uC2A4\uB7EC\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083390
    m_Localized: "\uAE08\uAC15\uD30C\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 28442083391
    m_Localized: "\"\uB098\uB294 \uAE08\uAC15\uC11D\uC774\uB2E4! \uB098\uB294 \uACAC\uACE0\uD55C
      \uBC14\uC704\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28442083392
    m_Localized: "\uAE08\uAC15\uC11D\uCC98\uB7FC \uB2E8\uB2E8\uD55C \uC758\uC9C0\uC640
      \uBC14\uC704\uCC98\uB7FC \uACAC\uACE0\uD55C \uC721\uCCB4\uB97C \uC9C0\uB2CC
      \uC804\uC7A5\uC758 \uB300\uB4E4\uBCF4. \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uB0B8\uB2E4\uB294
      \uAC01\uC624\uB294 \uADF8\uB4E4\uC744 \uB354\uC6B1 \uAC15\uB825\uD558\uAC8C
      \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28442083393
    m_Localized: "\uC2E0\uAD81"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277632
    m_Localized: "\"\uC81C \uD45C\uC801\uC740 \uB9C8\uC74C \uC18D\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277633
    m_Localized: "\uC2E0\uAD81\uC758 \uD654\uC0B4\uC740 \uBCF4\uC774\uC9C0 \uC54A\uB294
      \uBAA9\uD45C\uBB3C\uB3C4 \uBC18\uB4DC\uC2DC \uC801\uC911\uD558\uB294 \uC2E0\uBB18\uD568\uC744
      \uBCF4\uC5EC\uC900\uB2E4. \uC548\uAC1C\uAC00 \uC790\uC6B1\uD55C \uB0A0\uC5D0\uB3C4
      \uC5B4\uAE40\uC5C6\uC774 \uB0A0\uC544\uC640 \uAD00\uD1B5\uD558\uB294 \uD654\uC0B4\uC5D0
      \uC801\uAD70\uB4E4\uC740 \uD63C\uBE44\uBC31\uC0B0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277634
    m_Localized: "\uC2E0\uD1B5\uD3EC\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277635
    m_Localized: "\"\uC555\uB3C4\uC801\uC778 \uD654\uB825\uB9CC\uC774 \uC804\uC7A5\uC758
      \uC2B9\uB9AC\uB97C \uC774\uB04C\uC5B4\uB0BC \uC218 \uC788\uC9C0!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277636
    m_Localized: "\uCD1D\uACFC \uC720\uD0C4\uC758 \uB300\uAC00\uB85C \uADF8\uC758
      \uC6C3\uC74C\uC18C\uB9AC\uB9CC\uD07C \uD638\uBC29\uD558\uACE0 \uD654\uB048\uD55C
      \uD654\uB825\uC758 \uBB34\uAE30\uB85C \uC5B8\uC81C\uB098 \uC804\uC7A5\uC758
      \uC2B9\uB9AC\uB97C \uC774\uB04C\uC5B4\uC654\uB2E4. \uD544\uC911\uC758 \uC0AC\uACA9
      \uC19C\uC528\uB85C \uC801\uC744 \uBE60\uB974\uAC8C \uAFF0\uB6AB\uACE0 \uC720\uD0C4\uC744
      \uB358\uC838 \uBAB0\uB824\uC624\uB294 \uC801\uC744 \uADA4\uBA78\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277637
    m_Localized: "\uC120\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277638
    m_Localized: "\"\uCC9C\uC9C0\uC778\uC758 \uC870\uD654\uB97C \uC774\uD574\uD55C\uC790
      \uD30C\uB3C4\uB97C \uAC70\uC2A4\uB974\uC9C0 \uC54A\uACE0 \uC62C\uB77C\uD0C0\uB294
      \uBC95\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277639
    m_Localized: "\uB3C4\uC220\uC774 \uC798 \uD1B5\uD55C\uB2E4\uB294 \uAC83\uC740
      \uADF8\uB9CC\uD07C \uC720\uC704\uBC95\uC758 \uC6D0\uB9AC\uB97C \uAC04\uD30C\uD55C
      \uAC83\uC73C\uB85C \uC0AC\uB78C\uC758 \uACBD\uC9C0\uB97C \uB6F0\uC5B4\uB118\uB294
      \uACBD\uC9C0\uC774\uB2E4. \uC120\uC778\uC774 \uC0AC\uC6A9\uD558\uB294 \uC2E0\uD1B5\uD55C
      \uACC4\uD68D\uC740 \uC801\uC5D0\uAC8C \uD070 \uC2DC\uB828\uC774 \uB418\uACE0
      \uC544\uAD70\uC758 \uD655\uC2E0\uC774 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277640
    m_Localized: "\uB300\uC2B9"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277641
    m_Localized: "\"\uC77C\uCCB4\uC720\uC704\uBC95 \uC5EC\uBABD\uD658\uD3EC\uC601
      \uC5EC\uB85C\uC5ED\uC5EC\uC804 \uC751\uC791\uC5EC\uC2DC\uAD00\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277642
    m_Localized: "\uD754\uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uD3C9\uC815\uC2EC\uC73C\uB85C
      \uBCF8\uC9C8\uC744 \uAC04\uD30C\uD558\uBA70, \uC804\uC7A5\uC5D0\uC11C \uC758\uBCD1\uC758
      \uC815\uC2E0\uC801 \uC9C0\uC8FC\uAC00 \uB418\uC5B4\uC8FC\uB294 \uC874\uC7AC\uC774\uB2E4.
      \uADF8\uC758 \uC5F0\uC124\uC740 \uC628\uD654\uD558\uACE0 \uD655\uACE0\uD558\uC5EC
      \uC758\uBCD1\uB4E4\uC5D0\uAC8C \uC704\uC548\uC774 \uB418\uC5B4\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277643
    m_Localized: "\uB9CC\uC2E0"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277644
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 28446277645
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 28446277646
    m_Localized: "\uC120\uB140"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277647
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 28446277648
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 28446277649
    m_Localized: "\uB178\uC5ED\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277650
    m_Localized: "\"\uC8FD\uC73C\uB77C\uBA74 \uC8FD\uB294 \uAC70\uC9C0. \uC0B4\uC544\uBD10\uC57C
      \uBCC4\uC218 \uC788\uB098.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277651
    m_Localized: "\uC870\uC120\uC73C\uB85C \uB04C\uB824\uC628 \uAC01\uAD6D\uC758
      \uAC15\uC81C \uB178\uC5ED\uC790. \uBCF8\uB514 \uB18D\uC0AC\uBA70 \uACE0\uAE30\uC7A1\uC774\uB97C
      \uD558\uB358 \uD3C9\uBC94\uD55C \uBC31\uC131\uC774\uC5C8\uC73C\uB098, \uB0AF\uC120
      \uB098\uB77C\uC5D0\uC11C \uC190\uC5D0 \uD53C \uBB3B\uC740 \uB3C4\uB07C\uB97C
      \uC950\uAC8C \uB418\uC5C8\uB2E4. \uBC18\uCBE4 \uC8FD\uC740 \uB208\uBE5B\uC73C\uB85C
      \uD718\uB450\uB974\uB294 \uADF8 \uB3C4\uB07C\uB294 \uC790\uC2E0\uC758 \uC0B6\uC744
      \uBD80\uC815\uB2F9\uD55C \uC790\uC758 \uBB34\uC5B8\uC758 \uC800\uD56D\uCC98\uB7FC
      \uB290\uAEF4\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277652
    m_Localized: "\uC218\uC0C1\uD55C \uBB34\uC5ED\uC0C1"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277653
    m_Localized: "\"\uBB34\uC5C7\uC744 \uAD50\uD658\uD574 \uBCFC\uAE4C\uC694? \uC774
      \uC2DD\uCE7C \uD558\uB098\uC5D0 \uD585\uC300 \uCC9C \uAC00\uB9C8\uB2C8\uB294
      \uC5B4\uB5A0\uC2E0\uC9C0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277654
    m_Localized: "\uB208 \uB728\uACE0 \uCF54 \uBCA0\uC774\uACE0 \uC2F6\uB2E4\uBA74
      \uC0C1\uC778\uACFC \uD55C\uB450 \uB9C8\uB514\uB9CC \uC11E\uC73C\uBA74 \uB41C\uB2E4.
      \uAC00\uACA9\uB300\uB97C \uBBF8\uB9AC \uD30C\uC545\uD574 \uB193\uB294\uB2E4\uBA74
      \uC218\uC6D4\uD788 \uAC70\uB798\uB97C \uD560 \uC218 \uC788\uC9C0\uB9CC \uB9D0\uC774\uB2E4(\"\uADF8\uB807\uAC8C\uAE4C\uC9C0
      \uC591\uC2EC\uC774 \uC5C6\uC9C4 \uC54A\uC9C0\uC694!\"). \uB2E4\uC18C \uBED4\uBED4\uD55C
      \uB9CC\uD07C \uCCA0\uD310\uC744 \uAE54\uAE34 \uAE54\uC558\uB294\uC9C0 \uCCB4\uB825\uC774
      \uC870\uAE08 \uB192\uC740 \uD3B8\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277655
    m_Localized: "\uAD50\uD65C\uD55C \uD1B5\uC5ED\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277656
    m_Localized: "\"\uB0B4 \uD5C8\uB77D \uC5C6\uC774\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC0AC\uACE0\uD314 \uC218 \uC5C6\uC9C0. \uC554. \uADF8\uB807\uACE0 \uB9D0\uACE0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277657
    m_Localized: "\uD1B5\uC81C\uD615 \uAE30\uC9C8\uC744 \uAC00\uC9C4 \uD558\uAE09
      \uAD00\uB8CC. \uC790\uC2E0\uC774 \uC5C6\uC73C\uBA74 \uC5B4\uB5A4 \uAD50\uC5ED\uB3C4
      \uBB34\uD6A8\uB77C\uACE0 \uC8FC\uC7A5\uD55C\uB2E4. \uB531\uD788 \uAE30\uC220\uC774\uB098
      \uB3C4\uAD6C, \uC7AC\uC8FC\uB3C4 \uC5C6\uC73C\uB2C8 \uC9C0\uC704\uAC00 \uAD8C\uC704\uB97C
      \uB9CC\uB4E0 \uACBD\uC6B0\uB77C\uACE0 \uBCFC \uC218 \uC788\uB2E4. \uCC98\uC74C
      \uBCF8 \uC0C1\uB300\uC5D0\uAC8C\uB3C4 \uB0C5\uB2E4 \uC794\uC18C\uB9AC\uB97C
      \uD558\uAC70\uB098 \uC190\uC744 \uC704\uD611\uC801\uC73C\uB85C \uC62C\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277658
    m_Localized: "\uD544\uC0AC\uC758 \uD2B9\uACF5\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277659
    m_Localized: "\"\uC81C \uC0B6\uC758 \uAE38\uC774\uB294 \uADF8\uC800 \uC774 \uB3C4\uD654\uC120
      \uD55C \uBF18\uB9CC\uD07C\uC77C \uBFD0\uC774\uC9C0\uC694(\uC528\uC775)\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277660
    m_Localized: "\uC81C\uAD6D\uC5D0 \uCDA9\uC131\uC744 \uB9F9\uC138\uD55C \uC790,
      \uD639\uC740 \uADF8\uB807\uAC8C \uC138\uB1CC\uB2F9\uD55C \uC790. \uBA85\uB839\uC774
      \uB0B4\uB824\uC9C0\uBA74 \uAC00\uBC29\uC744 \uBA54\uACE0 \uC801\uC9C4 \uD55C\uBCF5\uD310\uC73C\uB85C
      \uB3CC\uC9C4\uD574 \uD3ED\uD0C4\uC744 \uD130\uB728\uB9B0\uB2E4. \uAD11\uAE30\uC5D0
      \uAC00\uAE4C\uC6B4 \uCDA9\uC131\uC2EC\uC744 \uD488\uACE0 \uB2EC\uB824\uB4DC\uB294
      \uD2B9\uACF5\uBCD1\uC758 \uC5BC\uAD74\uC744 \uBCF8 \uB0A0\uC5D0\uB294 \uB204\uAD6C\uB098
      \uBC24\uC7A0\uC744 \uC124\uCE5C\uB2E4\uACE0 \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277661
    m_Localized: "\uD544\uC0AC\uC758 \uC800\uACA9\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277662
    m_Localized: "\"\uD654\uC0B4 \uD558\uB098\uC5D0 \uC801 \uD558\uB098. \uC148\uC740
      \uD655\uC2E4\uD574\uC57C\uC8E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277663
    m_Localized: "\uD669\uC81C\uC5D0\uAC8C \uCDA9\uC131\uC744 \uB9F9\uC138\uD55C
      \uAD81\uBCD1\uB300 \uC18C\uC18D. \uC218\uB828\uACFC \uC8FC\uC785\uC2DD \uAD50\uC721\uC744
      \uD1B5\uD574 \uC778\uAC04\uC131\uC744 \uC9C0\uC6B4 \uD6C4, \uAE30\uACC4\uCC98\uB7FC
      \uC870\uC900\uD558\uACE0 \uC3D8\uB294 \uAC83\uC744 \uBC18\uBCF5\uD55C\uB2E4.
      \uC0DD\uC874\uBCF4\uB2E4\uB294 \uBA85\uC911\uB960\uC774 \uC6B0\uC120\uC774\uAE30\uC5D0
      \uC228\uD1B5\uC774 \uB04A\uC5B4\uC9C0\uB294 \uC21C\uAC04\uAE4C\uC9C0 \uD65C\uC2DC\uC704\uB97C
      \uB193\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277664
    m_Localized: "\uBD88\uAD74\uC758 \uC218\uB3C4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277665
    m_Localized: "\"\uB300\uB2F5\uC740 \uC815\uD574\uC838 \uC788\uB294 \uAC70 \uC54C\uC8E0?
      \uBBFF\uC2B5\uB2C8\uB2E4, \uD639\uC740 \uBBFF\uC2B5\uB2C8\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277666
    m_Localized: "\uC81C\uAD6D\uC758 \uC0AC\uC0C1\uC744 \uC774\uC2DD\uC2DC\uD0A4\uB294
      \uC815\uC2E0 \uAD50\uAD00. \uC544\uAD70\uC740 \uBB3C\uB860\uC774\uACE0 \uC801\uAD70\uACFC
      \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC744 \uC0AC\uC0C1 \uC55E\uC5D0 \uBB34\uB98E
      \uAFC7\uAC8C \uD558\uACE0, \uC800\uD56D\uC758 \uC2F9\uBD80\uD130 \uB9D0\uB824\uBC84\uB9B0\uB2E4.
      \uB9C8\uBC95\uACFC \uC5B8\uC5B4\uB97C \uBCD1\uAE30\uCC98\uB7FC \uB2E4\uB8E8\uAE30\uC5D0
      \uADF8\uC758 \uC874\uC7AC \uC790\uCCB4\uB85C \uAE4A\uC740 \uC815\uC2E0\uC801
      \uCE68\uC2DD\uC744 \uBD88\uB7EC\uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277667
    m_Localized: "\uBD88\uAD74\uC758 \uAC80\uAC1D"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277668
    m_Localized: "\"\uC608\uC815\uB41C \uC77C\uC774\uAE30\uC5D0 \uC624\uD788\uB824
      \uB450\uB835\uC9C0 \uC54A\uC18C\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277669
    m_Localized: "\uB300\uB300\uB85C \uAC80\uC0AC\uC758 \uACC4\uBCF4\uB97C \uC774\uC5B4\uC628
      \uBB34\uC608\uC778. \uAC00\uBB38\uACFC \uB098\uB77C, \uC804\uD1B5\uC758 \uC911\uC555\uAC10\uC744
      \uC548\uACE0 \uC2F8\uC6B4\uB2E4. \uB3C4\uBC1C \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uC5EC
      \uC790\uC2E0\uB9CC \uACF5\uACA9\uD558\uB3C4\uB85D \uC720\uB3C4\uD574 \uB3D9\uB8CC\uB97C
      \uC9C0\uD0A8\uB2E4. \uC804\uC7A5\uC744 \uC608\uC758 \uD130\uB85C \uC5EC\uAE30\uB294
      \uC790\uC774\uBA70, \uC608\uC758 \uB05D\uC5D0 \uC8FD\uC74C\uC774 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uB2E4\uB294 \uAC83\uB3C4 \uC798 \uC54C\uACE0 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277670
    m_Localized: "\uD544\uC0B4\uC758 \uBB34\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277671
    m_Localized: "\"\uD669\uC81C\uAED8 \uB2FF\uC73C\uB824\uB294 \uC190\uC740 \uC804\uBD80
      \uB315\uAC15\u2500\uC774\uC9C0!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277672
    m_Localized: "\uD669\uC81C\uB97C \uAC00\uC7A5 \uAC00\uAE4C\uC774\uC5D0\uC11C
      \uD638\uC704\uD558\uB358 \uC9C1\uC18D \uADFC\uC704\uBCD1. \uCCA0\uAC11\uC744
      \uAC78\uCE5C \uADF8 \uC721\uCCB4\uB294 \uCC3D\uBCF4\uB2E4 \uBE60\uB974\uACE0,
      \uBC29\uD328\uBCF4\uB2E4 \uB2E8\uB2E8\uD558\uB2E4. \uC218\uD638\uB780 \uADF8\uC5D0\uAC8C
      \uC788\uC5B4 \uBC29\uC5B4\uAC00 \uC544\uB2CC \uC120\uC81C \uACF5\uACA9\uC758
      \uB2E4\uB978 \uC774\uB984\uC774\uBA70, \uD669\uC81C\uC5D0\uAC8C \uB2FF\uC73C\uB824\uB294
      \uC790\uB294 \uB204\uAD6C\uB4E0 \uBA3C\uC800 \uC4F0\uB7EC\uB728\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277673
    m_Localized: "\uC0B4\uC778\uADC0 \uC190\uB300\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277674
    m_Localized: "\"\uD0DC\uC591\uAED8\uC120 \uC26C\uC9C0 \uC54A\uC73C\uC2ED\uB2C8\uB2E4.
      \uADF8\uB7EC\uB2C8 \uC800\uB3C4 \uC274 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277675
    m_Localized: "\uACE0\uB41C \uB178\uC5ED\uC744 \uD558\uB2E4 \uD669\uC81C\uC758
      \uB208\uC5D0 \uB744\uC5B4 \uD669\uAD70\uC5D0\uC11C \uD6C8\uB828\uB41C \uC778\uAC04
      \uBCD1\uAE30. \uC644\uC804\uD55C \uBCF5\uC885\uC744 \uCCB4\uD654\uD55C \uADF8\uB294
      \uD669\uC81C \uB355\uC5D0 \uB450 \uBC88\uC9F8 \uC0DD\uC744 \uC0B4\uAC8C \uB418\uC5C8\uB2E4\uBA70
      \uB9E4\uC77C\uAC19\uC774 \uAC10\uBCF5\uD55C\uB2E4. \uC190\uC5D0 \uB4E0 \uCD1D\uC740
      \uBCF5\uC885\uC758 \uC0C1\uC9D5\uC774\uB2E4. \uC870\uC120\uC744 \uBE44\uB86F\uD574
      \uC758 \uC0B0\uCC9C\uC744 \uADF8\uC758 \uBC1C\uBC11\uC5D0\uC11C \uBD88\uD0C0\uC624\uB974\uAC8C
      \uB9CC\uB4E4 \uC148\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277676
    m_Localized: "\uC804\uC7C1\uC2E0 \uBD89\uC740\uC544\uADC0"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277677
    m_Localized: "\"\uB098\uB294 \uCE7C\uC744 \uB4E4\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uC800
      \uD0DC\uC591\uC758 \uB73B\uC744 \uB0B4\uBCF4\uC77C \uBFD0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277678
    m_Localized: "\uC81C\uAD6D\uC758 \uC9C4\uACA9\uC744 \uC120\uB3C4\uD558\uB294
      \uAD70\uB2E8\uC758 \uC911\uC2EC. \uD669\uC81C\uC758 \uB73B\uC744 \uAC00\uC7A5
      \uBA3C\uC800 \uBC1B\uB4DC\uB294 \u2018\uD0DC\uC591\uC758 \uD654\uC2E0\u2019\uC774\uB77C
      \uBD88\uB9AC\uB294 \uC790. \uAE08\uAC15\uBD88\uAD34\uC758 \uC544\uC6B0\uB77C\uB97C
      \uBFDC\uC5B4 \uC544\uAD70\uC774 \uBC1B\uB294 \uB370\uBBF8\uC9C0\uB97C \uAC10\uC18C\uC2DC\uD0A8\uB2E4.
      \uC804\uD22C \uC2E4\uB825\uACFC \uC2A4\uD0AC\uC744 \uB118\uC5B4 \uD669\uC81C\uC640
      \uAC00\uAE5D\uB2E4\uB294 \uC0AC\uC2E4\uB9CC\uC73C\uB85C\uB3C4 \uC544\uAD70\uC758
      \uC0AC\uAE30\uB97C \uBC14\uC9DD \uB04C\uC5B4\uC62C\uB9AC\uB294 \uC874\uC7AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277679
    m_Localized: "\uC138\uB1CC\uB41C \uAC1C\uCC99\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277680
    m_Localized: "\"\uB545\uC744 \uC77C\uAD6C\uB77C\uBA74 \uC77C\uAD6C\uACE0 \uBAA9\uC744
      \uB530\uB77C\uBA74 \uB530\uACA0\uC2B5\uB2C8\uB2E4!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277681
    m_Localized: "\uC0AC\uC774\uBE44 \uC2E0\uC559\uC5D0 \uD604\uD639\uB418\uC5B4
      \uBA3C \uBC14\uB2E4\uB97C \uAC74\uB108\uC628 \uBBFC\uAC04\uC778. \uC0C8\uB85C\uC6B4
      \uC7A5\uC18C\uB97C \uCC3E\uC544 \uADF8\uB4E4\uB9CC\uC758 \uC655\uAD6D\uC744
      \uAC74\uC124\uD558\uACE0\uC790 \uC870\uC120\uAE4C\uC9C0 \uC654\uB2E4. \uAD50\uC8FC\uC5D0\uAC8C
      \uB2E8\uB2E8\uD788 \uC138\uB1CC\uB418\uC5B4 \uC2DC\uD0A4\uB294 \uAC74 \uBB34\uC5C7\uC774\uB4E0
      \uD560 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uB2E4. \uC124\uB839 \uADF8\uAC83\uC774
      \uC57D\uD0C8\uACFC \uC0B4\uC721\uC77C\uC9C0\uB77C\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277682
    m_Localized: "\uC138\uB1CC\uB41C \uB178\uC608"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277683
    m_Localized: "\"\uC2DC\uD0A4\uB294 \uB300\uB85C \uB2E4 \uD560 \uD14C\uB2C8\uAE4C\u2026
      \uC624\uB298\uC740 \uC2A4\uBB34 \uB300\uB9CC \uB54C\uB824\uC8FC\uC2DC\uBA74
      \uC548 \uB420\uAE4C\uC694?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277684
    m_Localized: "\uC0AC\uC774\uBE44 \uAD50\uB2E8\uC5D0 \uBD99\uC7A1\uD600 \uAC01\uC885
      \uD5C8\uB4DC\uB81B\uC77C\uC744 \uAC70\uB4E4\uC5B4\uC628 \uC774\uB4E4. \uCC98\uC74C
      \uACE0\uD5A5\uB3C4 \uAC00\uC871\uB3C4 \uBAA8\uB450 \uBE7C\uC557\uACBC\uC744
      \uB54C\uB294 \uBCF5\uC218\uC2EC\uC5D0 \uBD88\uD0C0\uC62C\uB790\uC9C0\uB9CC,
      \uAD50\uB2E8\uC774 \uCCB4\uBC8C\uB85C \uB2E4\uC2A4\uB9AC\uAC00 \uBB34\uAE30\uB825\uD558\uAC8C
      \uBA85\uB839\uC744 \uB530\uB978\uB2E4. \uAD50\uB2E8\uC740 \uACE0\uB41C \uC77C\uACFC
      \uACE0\uBB38\uC73C\uB85C \uC0C1\uD574\uBC84\uB9B0 \uADF8\uB4E4\uC758 \uBAB8\uC744
      \uC54C\uB730\uD788 \uBC29\uD328\uB9C9\uC774\uB85C \uC0BC\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277685
    m_Localized: "\uB3C5\uADF9\uBB3C \uC6B4\uBC18\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277686
    m_Localized: "\"\uC2DC\uD0A4\uB294 \uB300\uB85C \uB2E4 \uD560 \uD14C\uB2C8\uAE4C\u2026
      \uC7A0\uC2DC\uB9CC\u2026 \uC26C\uAC8C \uD574\uC8FC\uC138\uC694\u2026.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277687
    m_Localized: "\uC5ED\uC2DC \uC0AC\uC774\uBE44 \uAD50\uB2E8\uC5D0 \uBD99\uC7A1\uD600
      \uC704\uD5D8\uD55C \uC77C\uC744 \uB3C4\uB9E1\uC544\uC628 \uC774\uB4E4. \uAC1C\uCC99\uC9C0\uC5D0
      \uC0B4\uD3EC\uD560 \uB3C5\uADF9\uBB3C\uC744 \uC6B4\uBC18\uD558\uB2E4 \uC911\uB3C5\uB418\uC5B4
      \uD53C\uBD80\uC0C9\uC774 \uAE30\uAD34\uD558\uAC8C \uBCC0\uD588\uACE0, \uC791\uC740
      \uACE0\uD1B5\uC740 \uB290\uB07C\uC9C0\uB3C4 \uBABB\uD558\uAC8C \uB418\uC5B4\uBC84\uB838\uB2E4.
      \uC0AC\uB9DD \uC2DC \uBAB8\uC18D\uC5D0 \uCD95\uC801\uB41C \uB3C5\uAC00\uC2A4\uB97C
      \uBC29\uCD9C\uD558\uC5EC 20% \uD655\uB960\uB85C \uC911\uB3C5 \uC0C1\uD0DC\uB97C
      \uC77C\uC73C\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277688
    m_Localized: "\uAD11\uAE30\uC758 \uD30C\uC218\uAFBC"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277689
    m_Localized: "\"\uAD50\uC8FC\uB2D8 \uADFC\uCC98\uB85C\uB294 \uBC8C\uB808 \uD55C
      \uB9C8\uB9AC\uB3C4 \uBABB \uC624\uAC8C \uD558\uB294 \uAC8C \uC6B0\uB9AC\uC758
      \uC2E0\uC131\uD55C \uC758\uBB34\uC9C0!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277690
    m_Localized: "\uAD50\uB2E8\uC758 \uCD5C\uD558\uAE09 \uBCD1\uC878. \uC5B4\uB835\uAC8C
      \uAE30\uC0AC\uB2E8\uC5D0 \uB4E4\uC5B4\uC654\uC73C\uB098 \uC774\uB807\uB2E4
      \uD560 \uC804\uACF5\uC774 \uC5C6\uC5B4 \uD30C\uC218\uAFBC\uC73C\uB85C \uBC30\uCE58\uB418\uC5C8\uB2E4.
      \uADF8\uB7EC\uB098 '\uD30C\uC218\uAFBC'\uC774\uB77C\uB294 \uBA85\uCE6D\uC774
      \uC774\uB4E4\uC758 \uC0AC\uAE30\uB97C \uBD81\uB3CB\uC558\uB294\uC9C0 \uC790\uC138\uAC00
      \uC544\uC8FC \uC801\uADF9\uC801\uC774\uB2E4. \uCCB4\uB825\uB3C4 \uD798\uB3C4
      \uC560\uB9E4\uD558\uC9C0\uB9CC, \uAD50\uC8FC\uB97C \uC9C0\uD0A4\uAE30 \uC704\uD574\uC11C\uB77C\uBA74
      \uBB3C\uBD88 \uAC00\uB9AC\uC9C0 \uC54A\uACE0 \uAD11\uAE30\uC758 \uD65C\uC744
      \uC3D8\uC544\uBCF4\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277691
    m_Localized: "\uAD11\uAE30\uC758 \uC815\uCC30\uBCD1"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277692
    m_Localized: "\"\uD22C\uC9C0\uB97C \uBD88\uD0DC\uC6CC\uB77C! \uB0B4\uAC00 \uAD50\uC8FC\uB2D8\uC758
      \uB208\uC774 \uB418\uC5B4 \uC0B4\uD53C\uACE0 \uC788\uC73C\uB2C8!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28446277693
    m_Localized: "\uB113\uC740 \uC9C0\uC5ED\uC744 \uC815\uCC30\uD558\uB294 \uC815\uCC30\uC790.
      \uD22C\uC9C0 \uC544\uC6B0\uB77C\uB97C \uBFDC\uC5B4 \uC8FC\uBCC0\uC5D0 \uC788\uB294
      \uC544\uAD70\uC5D0\uAC8C \uD22C\uC9C0 \uC0C1\uD0DC\uB97C \uBD80\uC5EC\uD55C\uB2E4.
      \uC791\uC740 \uCD1D\uC73C\uB85C \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744, \uCC0C\uB974\uAE30\uB85C
      \uADFC\uAC70\uB9AC \uACF5\uACA9\uC744 \uD55C\uB2E4. \uBC29\uD0C4\uAC11\uC744
      \uC785\uACE0 \uC788\uC5B4 \uD30C\uC218\uAFBC\uBCF4\uB2E4 \uC870\uAE08 \uCCB4\uB825\uC774
      \uAC15\uD558\uB2E4. \uAD50\uC8FC\uC758 \uB208\uC5D0 \uB4E4\uAE30 \uC704\uD574\uC11C\uB77C\uBA74
      \uBB3C\uBD88 \uAC00\uB9AC\uC9C0 \uC54A\uACE0 \uAD11\uAE30\uC758 \uCD1D\uC54C\uC744
      \uC3DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28446277694
    m_Localized: "\uAD11\uAE30\uC758 \uC9D1\uD589\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28446277695
    m_Localized: "\"\uBD88\uC2E0\uD55C \uC790\uC5EC, \uADF8 \uC8C4\uB97C \uB124 \uD53C\uB85C
      \uAC1A\uC544\uB77C!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471936
    m_Localized: "\uC774\uB2E8\uC790\uC5D0 \uB300\uD55C \uC2EC\uD310\uC744 \uC218\uD589\uD558\uB294
      \uC790. \uC774\uB4E4\uC740 \uAD50\uB2E8\uC758 \uAC00\uB974\uCE68\uC5D0\uC11C
      \uBC97\uC5B4\uB09C \uC790\uB4E4\uC744 \uC9C1\uC811 \uCC98\uD615\uD568\uC73C\uB85C\uC368
      \uC790\uC2E0\uC774 \u2018\uC815\uC758\u2019\uB97C \uAD6C\uD604\uD558\uACE0
      \uC788\uB2E4\uACE0 \uBBFF\uB294\uB2E4. \uADF8 \uAD11\uC2E0\uC758 \uB208\uBE5B\uC5D4
      \uB2E8 \uD558\uB098\uC758 \uD655\uC2E0\uB9CC\uC774 \uAE43\uB4E4\uC5B4 \uC788\uB2E4\u2014\uD53C\uB294
      \uC8C4\uB97C \uC53B\uB294 \uBB3C\uC774\uB77C\uB294 \uAC83."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471937
    m_Localized: "\uAD11\uAE30\uC758 \uD3ED\uC57D \uAE30\uC220\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471938
    m_Localized: "\"\uAE08\uBE5B \uACC4\uC2DC\uAC00 \uB0B4 \uADC0\uC5D0 \uC18D\uC0AD\uC600\uC5B4.
      \uB2E4 \uB0A0\uB824\uBC84\uB9AC\uB77C\uACE0!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471939
    m_Localized: "\uC9C0\uD558\uC5D0\uC11C \uAD11\uB9E5\uC744 \uCC3E\uB2E4 \uD3ED\uC57D\uC5D0
      \uBE60\uC9C4 \uAE30\uC220\uC790. \uC774\uC81C \uADF8\uB294 \uD669\uAE08\uC758
      \uACC4\uC2DC\uB97C \uC887\uC544 \uC628\uBAB8\uC5D0 \uD3ED\uD0C4\uC744 \uB450\uB974\uACE0
      \uC801\uC9C4\uC73C\uB85C \uB6F0\uC5B4\uB4E0\uB2E4. \uC8FD\uC74C\uC740 \uADF8\uC5D0\uAC8C
      \uB05D\uC774 \uC544\uB2CC \uC99D\uBA85\uC774\uAE30\uC5D0, \uAD11\uAE30\uC758
      \uBBF8\uC18C\uB85C \uC790\uD3ED\uD574 \uBAA8\uB450\uB97C \uB04C\uACE0 \uAC04\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471940
    m_Localized: "\uD0C0\uB77D\uD55C \uC120\uBD09\uAE30\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471941
    m_Localized: "\"\uC804\uC9C4\uD558\uB77C! \uC6B0\uB9AC\uC758 \uBC1C\uAC78\uC74C\uC774
      \uC2E0\uC758 \uAE38\uC744 \uC5F4\uC9C0\uC5B4\uB2C8!\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471942
    m_Localized: "\uBCF8\uB798\uB294 \uAC1C\uCC99\uC758 \uC120\uBD09\uC7A5\uC774\uC5C8\uC73C\uB098,
      \uAD50\uB2E8\uC758 \uBA85\uB839\uC5D0 \uB530\uB77C \uD30C\uAD34\uC640 \uC810\uB839\uC744
      \uC77C\uC0BC\uB294 \uC790\uAC00 \uB418\uC5C8\uB2E4. \uB290\uB9BF\uD558\uC9C0\uB9CC
      \uB2E8\uB2E8\uD558\uBA70, \uADF8\uC758 \uC804\uC9C4\uC740 \uB2E8\uC9C0 \uBB3C\uB9AC\uC801
      \uB3CC\uC9C4\uC774 \uC544\uB2CC \uC2E0\uC758 \uB73B\uC774\uB77C\uB294 \uB9DD\uC0C1\uC73C\uB85C
      \uAC15\uD654\uB41C \uC758\uC2DD \uADF8 \uC790\uCCB4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471943
    m_Localized: "\uD0C0\uB77D\uD55C \uC2EC\uBB38\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471944
    m_Localized: "\"\uC9C4\uC2E4\uC744 \uD1A0\uD558\uB77C. \uC544\uB2C8\uBA74, \uBE44\uBA85\uC744
      \uC9C0\uB974\uB3C4\uB85D.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471945
    m_Localized: "\uC774\uB2E8\uC790\uC758 \uACE0\uD1B5\uC744 \uD1B5\uD574 \uC2E0\uC758
      \uC758\uC9C0\uB97C \uB4DC\uB7EC\uB0B8\uB2E4\uACE0 \uBBFF\uB294 \uC2EC\uBB38\uC790.
      \uACE0\uBB38\uC740 \uC815\uD654\uC758 \uACFC\uC815\uC774\uBA70, \uBE44\uBA85\uC740
      \uD68C\uAC1C\uC758 \uC5B8\uC5B4\uB2E4. \uADF8\uC758 \uB3C4\uB07C\uB294 \uC0B4\uD574\uC758
      \uB3C4\uAD6C\uAC00 \uC544\uB2C8\uB77C \uAD50\uB2E8\uC758 \uC0AC\uB791\uC744
      \uAC15\uC81C\uB85C \uC8FC\uC785\uD558\uB294 \uC120\uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471946
    m_Localized: "\uD0C0\uB77D\uD55C \uAC00\uB514\uC5B8"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471947
    m_Localized: "\"\uBB34\uC5C7\uC774\uB4E0 \uC0C1\uAD00\uC5C6\uB2E4. \uC811\uADFC\uD558\uB294
      \uAC83\uB4E4\uC740 \uC804\uBD80 \uC81C\uAC70\uD574.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471948
    m_Localized: "\uBCF8\uB798\uB294 \uC6D0\uC8FC\uBBFC \uBCF4\uD638\uB97C \uC704\uD574
      \uACE0\uC6A9\uB41C \uACBD\uBE44\uBCD1\uC774\uC5C8\uC73C\uB098, \uAD50\uB2E8\uC758
      \uC138\uB1CC\uB85C \uCDA9\uC131\uC758 \uB300\uC0C1\uC744 \uBC14\uAFB8\uC5C8\uB2E4.
      \uAC80\uACFC \uC9D1\uB150 \uD558\uB098\uB85C \uC804\uC7A5\uC5D0 \uB6F0\uC5B4\uB4E4\uBA70,
      \uD0C0\uB77D\uD55C \uC2E0\uB150\uC740 \uADF8\uB97C \uB354\uC6B1 \uC644\uACE0\uD558\uACE0
      \uBB34\uC790\uBE44\uD558\uAC8C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471949
    m_Localized: "\uD0C0\uB77D\uD55C \uC804\uB3C4\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471950
    m_Localized: "\"\uCE58\uC720\uBC1B\uC744 \uC218 \uC788\uB2E4\uB9CC\uC694. \uBBFF\uAE30\uB9CC
      \uD55C\uB2E4\uBA74 \uB9D0\uC774\uC8E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471951
    m_Localized: "\uAC70\uC9D3\uB41C \uAD6C\uC6D0\uC744 \uC804\uD30C\uD558\uB294
      \uC804\uB3C4\uC0AC. \uADF8\uB294 \uC0C1\uCC98 \uC785\uC740 \uC790\uB97C \uCE58\uB8CC\uD558\uBA74\uC11C
      \uB3D9\uC2DC\uC5D0 \uC2E0\uC758 \uC774\uB984\uC73C\uB85C \uADF8\uB4E4\uC744
      \uC885\uC18D\uC2DC\uD0A8\uB2E4. \uBD09\uC5D0\uC11C \uBFDC\uC5B4\uC9C0\uB294
      \uD798\uC740 \uB2E8\uC9C0 \uC57D\uC774 \uC544\uB2C8\uB77C, \uC601\uD63C\uC744
      \uC0AC\uB85C\uC7A1\uB294 \uAD50\uB2E8\uC758 \uC0AC\uC2AC\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471952
    m_Localized: "\uC774\uB2E8 \uC2EC\uD310\uAD00 \uC81C\uB85C\uC5D8"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471953
    m_Localized: "\"\uC758\uC2EC\uC740 \uC8C4\uC694, \uB098\uC758 \uAC80\uC740 \uADF8
      \uC8C4\uC758 \uB05D\uC774\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471954
    m_Localized: "\uAC70\uB8E9\uD568\uC758 \uD0C8\uC744 \uC4F4 \uB0C9\uD608\uD55C.
      \uC2EC\uD310\uAD00 \uC81C\uB85C\uC5D8\uC740 \uC808\uB300\uC801\uC778 \uADDC\uC728\uACFC
      \uAD50\uB9AC\uB85C \uBB34\uC7A5\uD574 \uC774\uB2E8\uC790\uB97C \uAC00\uB824\uB0B4\uACE0,
      \uC790\uC2E0\uC758 \uC815\uC758\uB97C \uAC15\uC694\uD55C\uB2E4. \uADF8\uC758
      \uB3C4\uBC1C\uC740 \uB2E8\uC9C0 \uBD84\uB178\uB97C \uC720\uB3C4\uD558\uB294
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uAD11\uC2E0\uC744 \uC774\uB04C\uC5B4\uB0B4\uB294
      \uC885\uC758 \uD30C\uBB38\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471955
    m_Localized: "\uC2E0\uC131\uC804\uC0AC \uC5D0\uB4DC\uC6CC\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471956
    m_Localized: "\"\uB0B4 \uB9DD\uCE58\uB294 \uC815\uC758\uC758 \uB3C4\uC7A5\uC774\uB2E4.
      \uC2EC\uD310\uBC1B\uC744 \uC900\uBE44\uAC00 \uB418\uC5C8\uB294\uAC00?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471957
    m_Localized: "\uD314\uB77C\uB518\uC774\uB77C\uB294 \uC774\uB984\uC5D0 \uAC78\uB9DE\uAC8C
      \uBE5B\uACFC \uC9C4\uC2E4\uC744 \uC678\uCE58\uC9C0\uB9CC, \uADF8 \uB9DD\uCE58\uB294
      \uC790\uBE44\uAC00 \uC544\uB2CC \uD30C\uAD34\uC758 \uB3C4\uAD6C\uB2E4. \uC9D5\uBC8C\uC790
      \uC5D0\uB4DC\uC6CC\uB4DC\uB294 \uAD50\uB2E8\uC758 \uC758\uC9C0\uB97C \uAD6C\uD604\uD558\uB294
      \uC131\uC2A4\uB7EC\uC6B4 \uD30C\uAD34\uC790\uC774\uBA70, \uC2E0\uC758 \uC774\uB984\uC73C\uB85C
      \uBAA8\uB4E0 \uC774\uB2E8\uC744 \uC9D3\uBC1F\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471958
    m_Localized: "\uD0D0\uC695\uC758 \uAD50\uC8FC \uD5E8\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471959
    m_Localized: "\"\uADF8\uB300\uB4E4\uC758 \uC601\uD63C\uC870\uCC28 \uB098\uC758
      \uC2E0\uC804\uC744 \uC704\uD55C \uC5F0\uB8CC\uC774\uB2C8\uB77C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471960
    m_Localized: "\uC0AC\uC774\uBE44 \uAD50\uB2E8\uC758 \uC808\uB300\uC790. \uBBFF\uC74C\uACFC
      \uAD6C\uC6D0\uC744 \uBE4C\uBBF8\uB85C \uC601\uD63C\uACFC \uC7AC\uC0B0\uC744
      \uCC29\uCDE8\uD558\uB294 \uC545\uB9C8\uC5D0 \uAC00\uAE4C\uC6B4 \uC778\uBB3C.
      \uD5E8\uB9AC\uB294 \uB300\uC911\uC744 \uD640\uB9AC\uB294 \uC124\uB4DD\uB825\uACFC
      \uAE30\uAD34\uD55C \uCE74\uB9AC\uC2A4\uB9C8\uB97C \uC9C0\uB154\uC73C\uBA70,
      \uC801 \uC55E\uC5D0\uC11C \uACB8\uD5C8\uD55C \uC6C3\uC74C \uB4A4\uC5D0 \uB9F9\uB3C5
      \uAC19\uC740 \uAE30\uB3C4\uB97C \uC18D\uC0AD\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471961
    m_Localized: "\uC6A9\uBCD1\uB2E8 \uAD81\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471962
    m_Localized: "\"\uD760, \uC870\uBB34\uB798\uAE30\uB4E4\uACFC \uBE44\uAD50\uD558\uC9C0
      \uB9D0\uC544\uC8FC\uC2DC\uACA0\uC5B4\uC694?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471963
    m_Localized: "\uCC99\uBC15\uD55C \uACE0\uD5A5 \uC0AC\uB9C9\uC5D0 \uB3C8\uC744
      \uBC8C\uC5B4\uB2E4 \uC8FC\uAE30 \uC704\uD574 \uC790\uC6D0\uD55C \uC804\uBB38
      \uC6A9\uBCD1. \uC5B4\uB838\uC744 \uB54C\uBD80\uD130 \uD2B9\uC218 \uD6C8\uB828\uC744
      \uBC1B\uC558\uAE30\uC5D0 \uAE30\uBCF8 \uACF5\uACA9\uB825\uACFC \uCCB4\uB825\uC774
      \uB192\uACE0 \uADF8\uB9CC\uD07C \uCF67\uB300\uB3C4 \uC544\uC8FC \uB192\uB2E4.
      \uBC1B\uC740 \uB9CC\uD07C \uACF5\uACA9\uD558\uAE30 \uB54C\uBB38\uC5D0 \uC794\uD639\uD558\uB3C4\uB85D
      \uAE54\uB054\uD558\uACE0 \uBE60\uB974\uAC8C \uD65C\uC744 \uC3D8\uB294 \uAC83\uC774
      \uD2B9\uC9D5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471964
    m_Localized: "\uD6C8\uB828\uB41C \uB3C4\uC57D\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471965
    m_Localized: "\"(\uD718\uB9AD) \uC774 \uC815\uB3C4\uB294 \uBAB8\uD480\uAE30\uB77C\uACE0
      \uBCFC \uC218 \uC788\uC8E0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471966
    m_Localized: "\uC5ED\uC2DC \uCC99\uBC15\uD55C \uACE0\uD5A5 \uC0AC\uB9C9\uC5D0
      \uB3C8\uC744 \uBC8C\uC5B4\uB2E4 \uC8FC\uAE30 \uC704\uD574 \uC790\uC6D0\uD55C
      \uC804\uBB38 \uC6A9\uBCD1. \uC5B4\uB838\uC744 \uB54C\uBD80\uD130 \uAE30\uB3D9\uB825
      \uC704\uC8FC\uC758 \uD2B9\uC218 \uD6C8\uB828\uC744 \uBC1B\uC558\uAE30\uC5D0
      \uC720\uACA9\uB300\uC6D0\uC73C\uB85C \uD0C1\uC6D4\uD55C \uC2E4\uB825\uC744
      \uBCF4\uC5EC\uC900\uB2E4. \uAE34 \uCC3D\uC744 \uACF5\uACA9\uBFD0 \uC544\uB2C8\uB77C
      \uBC14\uB9AC\uCF00\uC774\uD2B8\uB97C \uB6F0\uC5B4\uB118\uB294 \uB370 \uC774\uC6A9\uD558\uC5EC
      \uBC29\uC5B4 \uC9C4\uC601\uC744 \uBB34\uB825\uD654\uD574\uBC84\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471967
    m_Localized: "\uC6A9\uBCD1\uB2E8 \uC0B4\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471968
    m_Localized: "\"\u2026\uB0B4\uAC00 \uBCF4\uC5EC? \uCE6B, \uC774\uBC88 \uD55C
      \uBC88\uB9CC \uBD10\uC8FC\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471969
    m_Localized: "\uC5ED\uC2DC \uCC99\uBC15\uD55C \uACE0\uD5A5 \uC0AC\uB9C9\uC5D0
      \uB3C8\uC744 \uBC8C\uC5B4\uB2E4 \uC8FC\uAE30 \uC704\uD574 \uC790\uC6D0\uD55C
      \uC804\uBB38 \uC6A9\uBCD1. \uC740\uC2E0\uC5D0 \uB2A5\uD55C \uC5D8\uB9AC\uD2B8\uB9CC
      \uC0B4\uC218\uB85C \uC740\uBC00\uD558\uAC8C \uD6C8\uB828\uB41C\uB2E4. \uC554\uC0B4\uC774
      \uC804\uBB38\uC778 \uB9CC\uD07C \uADF8 \uC2E4\uCCB4\uB97C \uBCF8 \uC0AC\uB78C\uC774
      \uB4DC\uBB3C\uB2E4\uB294\uB370 \uC720\uB3C5 \uC870\uC120\uC5D0\uC11C\uB294
      \uC790\uC8FC \uBAA9\uACA9\uB41C\uB2E4. \uC870\uC120\uC758 \uD669\uAE08\uBE5B
      \uB4E4\uB158\uC5D0 \uC0AC\uB9C9\uC758 \uD5A5\uC218\uB97C \uB290\uAEF4 \uACBD\uACC4\uC2EC\uC774
      \uD750\uD2B8\uB7EC\uC84C\uB2E4\uB294 \uC124\uC774 \uC720\uB825\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471970
    m_Localized: "\uC2E0\uAE30\uB8E8 \uBA54\uB515"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471971
    m_Localized: "\"\uC774\uAC74 \uC57D\uC774\uC790 \uAE30\uB3C4\uC785\uB2C8\uB2E4.
      \uD53C\uB97C \uBA48\uCD94\uB294 \uC8FC\uBB38, \uB4E4\uC73C\uC168\uC8E0?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471972
    m_Localized: "\uC0AC\uB9C9 \uBD80\uC871 \uD2B9\uC720\uC758 \uC758\uC220\uACFC
      \uC8FC\uBB38\uC744 \uBCD1\uD589\uD558\uB294 \uCE58\uC720\uC0AC. \uD53C\uB97C
      \uBA4E\uAC8C \uD558\uACE0, \uBF08\uB97C \uBD99\uC774\uACE0, \uC2EC\uC9C0\uC5B4
      \uACF5\uD3EC\uB97C \uC9C4\uC815\uC2DC\uD0A4\uB294 \uADF8\uB140\uC758 \uC190\uB180\uB9BC\uC740
      \uC2E0\uAE30\uB8E8\uCC98\uB7FC \uC2E0\uBE44\uB86D\uB2E4. \uC815\uC81C\uB41C
      \uC218\uC815\uC744 \uC0AC\uC6A9\uD558\uBA70, \uADF8 \uC548\uC5D0\uC11C \uD758\uB7EC\uB098\uC624\uB294
      \uBE5B\uC73C\uB85C \uC544\uAD70\uC744 \uD68C\uBCF5\uC2DC\uD0A8\uB2E4. \uCE58\uB8CC\uB77C\uAE30\uBCF4\uB2E4\uB294
      \uC758\uC2DD\uC5D0 \uAC00\uAE4C\uC6B4 \uD589\uC704\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471973
    m_Localized: "\uC2E0\uAE30\uB8E8 \uD559\uC0B4\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471974
    m_Localized: "\"\uC0B4\uC544\uB0A8\uC744 \uC0DD\uAC01\uC740 \uB9D0\uC544\uC694.
      \uC774\uBBF8 \uC774\uB984\uC870\uCC28 \uC9C0\uC6B4 \uBAB8\uC774\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471975
    m_Localized: "\uBB34\uC5B4 \uC6A9\uBCD1\uB300 \uB0B4\uC5D0\uC11C\uB3C4 \u2018\uC2E4\uCCB4
      \uC5C6\uB294 \uAC80\u2019\uC774\uB77C \uBD88\uB9AC\uB294 \uADF8\uB9BC\uC790.
      \uB2E8\uB3C5 \uC7A0\uC785\uC740 \uBB3C\uB860, \uC9D1\uB2E8 \uD559\uC0B4\uB3C4
      \uB9E1\uB294 \uADF9\uB2E8\uC801 \uC554\uC0B4\uC790\uB2E4. \uADF8\uC758 \uCE7C\uB0A0\uC740
      \uB9F9\uB3C5\uC744 \uBA38\uAE08\uACE0 \uC788\uC5B4, \uC0C1\uCC98 \uD558\uB098\uB85C
      \uC218\uC2ED \uBA85\uC744 \uBB34\uB98E \uAFC7\uB9B0\uB2E4. \uC740\uC2E0\uACFC
      \uC811\uADFC\uC758 \uB2EC\uC778\uC778 \uADF8\uB294, \uC624\uB298\uB3C4 \uC801\uC758
      \uC228\uC18C\uB9AC\uB97C \uB530\uB77C \uCE7C\uC744 \uBF51\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471976
    m_Localized: "\uC2E0\uAE30\uB8E8 \uB808\uC778\uC800"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471977
    m_Localized: "\"\uBB34\uC5C7\uC774 \uAC00\uB85C\uB9C9\uB4E0\u2026 \uB118\uB294\uB2E4.
      \uADF8\uAC8C \uC6B0\uB9AC \uBC29\uC2DD\uC774\uB2C8\uAE4C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471978
    m_Localized: "\uCD5C\uC815\uC608 \uC720\uACA9\uB300 \uCD9C\uC2E0\uC73C\uB85C,
      \uC804\uC7A5\uC744 \uB204\uBE44\uBA70 \uAC00\uC7A5 \uBE60\uB974\uAC8C \uCE68\uD22C\uD558\uB294
      \uCC99\uD6C4\uBCD1. \uBCBD\uC774\uB4E0 \uAD6C\uB369\uC774\uB4E0 \uC7A5\uB300\uCC3D
      \uD558\uB098\uB85C \uB2E8\uC228\uC5D0 \uB3CC\uD30C\uD55C\uB2E4. \uADF8\uC758
      \uD0C4\uB825 \uC788\uB294 \uC7A5\uB300\uCC3D\uC740 \uC801\uC744 \uCC0C\uB974\uB294
      \uCC3D\uC774\uC790, \uC7A5\uC560\uBB3C\uC744 \uB118\uB294 \uB3C4\uC57D\uB300\uB2E4.
      \uC21C\uAC04\uC758 \uD2C8\uC744 \uBCF4\uACE0 \uB2EC\uB824\uB4DC\uB294 \uADF8\uC758
      \uC2E4\uB8E8\uC5E3\uC740, \uB9C8\uCE58 \uC2E0\uAE30\uB8E8\uCC98\uB7FC \uBD99\uC7A1\uD788\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471979
    m_Localized: "\uC2E0\uAE30\uB8E8 \uB3CC\uACA9\uC804\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471980
    m_Localized: "\"\uBA48\uCD94\uBA74 \uC8FD\uB294\uB2E4. \uC544\uC8FC \uAC04\uB2E8\uD55C
      \uC774\uCE58\uC796\uC544?\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471981
    m_Localized: "\uC6A9\uBCD1\uB300\uC758 \uCD5C\uC804\uBC29 \uB3CC\uACA9\uC218.
      \uBC29\uD328\uB85C \uAE38\uC744 \uC5F4\uACE0, \uAC80\uC73C\uB85C \uD2C8\uC744
      \uB9CC\uB4E0\uB2E4. \uADF8\uB140\uB294 \uB204\uAD6C\uBCF4\uB2E4 \uBE60\uB974\uAC8C
      \uC6C0\uC9C1\uC774\uBA70, \uB3D9\uB8CC\uB4E4\uC758 \uBC1C\uAC78\uC74C\uB9C8\uC800
      \uAC00\uBCCD\uAC8C \uB9CC\uB4DC\uB294 \uAE30\uBB18\uD55C \uAE30\uC6B4\uC744
      \uBFDC\uC5B4\uB0B8\uB2E4. \uC2E0\uC18D\uAE30\uB3D9 \uC544\uC6B0\uB77C\uB294
      \uB2E8\uC21C\uD55C \uAE30\uC220\uC774 \uC544\uB2C8\uB77C, \uADF8\uB140\uC758
      \uC0B6 \uADF8 \uC790\uCCB4\uB2E4. \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC73C\uBA74
      \uC8FD\uB294 \uC0AC\uB9C9\uC5D0\uC11C \uC628 \uADF8\uB140\uB294 \uBA48\uCD94\uB294
      \uBC95\uC744 \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471982
    m_Localized: "\uC5EC\uBA85\uC758 \uC6A9\uBCD1\uB300\uC7A5 \uB380\uC9C0\uBB34\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471983
    m_Localized: "\"\uB0B4 \uB4A4\uC5D0 \uC11C\uB77C. \uC801\uC758 \uCE7C\uB0A0\uC774
      \uB108\uB97C \uC2A4\uCE58\uC9C0\uB3C4 \uBABB\uD558\uAC8C \uD574\uC8FC\uC9C0.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471984
    m_Localized: "\uBB34\uC5B4 \uC6A9\uBCD1\uB300\uC758 \uC804\uC124\uC801\uC778
      \uB300\uC7A5. \uC804\uD22C\uB825 \uD558\uB098\uB85C \uC6A9\uBCD1 \uC138\uACC4\uC758
      \uC9C8\uC11C\uB97C \uBC14\uAFD4\uB193\uC740 \uADF8\uB294, \uB2E8\uC21C\uD55C
      \uCE7C\uC7A1\uC774\uB97C \uB118\uC5B4 \uC804\uC7A5\uC758 \uBC84\uD300\uBAA9\uC774\uB2E4.
      \uD638\uC704 \uC9C4\uD615 \uC544\uC6B0\uB77C\uB85C \uC8FC\uBCC0\uC758 \uC544\uAD70\uC5D0\uAC8C
      \uAE08\uAC15\uBD88\uAD34 \uC0C1\uD0DC\uB97C \uBD80\uC5EC\uD55C\uB2E4. \uADF8\uAC00
      \uC9C4\uD615\uC758 \uC911\uC2EC\uC5D0 \uC120 \uC21C\uAC04, \uBB34\uB9AC\uB294
      \uB2E8\uC21C\uD55C \uC6A9\uBCD1\uB300\uAC00 \uC544\uB2CC \u2018\uC6C0\uC9C1\uC774\uB294
      \uC694\uC0C8\u2019\uAC00 \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 28450471985
    m_Localized: "\uC2E0\uAE30\uB8E8\uC0AC\uC81C \uCE74\uD0C8\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 28450471986
    m_Localized: "\"\uB098\uC758 \uBAA9\uC18C\uB9AC\uB97C \uAC70\uC5ED\uD558\uB294
      \uC790, \uADF8\uC800 \uBB34\uB98E \uAFC7\uC744 \uAC83\uC774\uC57C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 28450471987
    m_Localized: "\uCE74\uD0C8\uB77C\uB294 \uB354 \uC774\uC0C1 \uC804\uC7A5\uC744
      \uBB34\uAE30\uB85C \uBB3C\uB4E4\uC774\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB140\uB294
      \uB9D0\uB85C, \uC124\uAD50\uB85C, \uB208\uBE5B \uD558\uB098\uB85C \uC801\uC744
      \uC704\uCD95\uC2DC\uD0A8\uB2E4. \uC2E0\uD0C1\uC758 \uC11C\uB294 \uADF8\uB140\uC758
      \uBB34\uAE30\uC774\uC790 \uC0C1\uC9D5\uC774\uBA70, \uADF8 \uC548\uC5D0\uB294
      \uC218\uB9CE\uC740 \uC608\uC5B8\uACFC \uC800\uC8FC\uAC00 \uB2F4\uACA8 \uC788\uB2E4.
      \uADF8\uB140\uC758 \uC55E\uC5D0\uC11C \uBB34\uB98E \uAFC7\uB294 \uAC74 \uC2E0\uC559\uC778\uAC00,
      \uACF5\uD3EC\uC778\uAC00. \uC5B4\uB290 \uCABD\uC774\uB4E0 \uACB0\uACFC\uB294
      \uAC19\uB2E4. \uBCF5\uC885\uBFD0."
    m_Metadata:
      m_Items: []
  - m_Id: 87099738619015168
    m_Localized: "\uD0DC\uC591\uC758 \uC2E0\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 87099739860529152
    m_Localized: "\"\uB0B4\uAC00 \uC804\uD558\uB294 \uB9D0\uC740 \uACE7 \uD0DC\uC591\uC758
      \uB9D0\uC77C\uC9C0\uB2C8, \uD0DC\uC591\uC744 \uBC1B\uB4E4\uC5B4\uB77C!\""
    m_Metadata:
      m_Items: []
  - m_Id: 87099740934270976
    m_Localized: "\uC790\uC2E0\uC744 \uC2E0\uC758 \uB300\uB9AC\uC790\uB85C \uBBFF\uC73C\uBA70,
      \uC81C\uAD6D \uC774\uC678\uC758 \uC0AC\uB78C\uB4E4\uC744 \uD669\uC81C\uC758
      \uB73B\uC744 \uBAA8\uB974\uB294 \uBBF8\uAC1C\uD55C \uC790\uB4E4\uB85C \uC0DD\uAC01\uD558\uB294
      \uD669\uC81C\uC758 \uC624\uB978\uD314."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
