  m_TableData:
  - m_Id: 38428721152
    m_Localized: "\uC9D1\uC911 \uC0AC\uACA9 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915456
    m_Localized: "\uC9C0\uC815\uD55C \uC601\uC5ED \uC18D \uC801\uAD70\uC5D0\uAC8C
      \uD654\uC0B4\uC744 \uC9D1\uC911 \uD3EC\uD654\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915457
    m_Localized: "\uC601\uC5ED \uB0B4\uC758 \uC801\uB4E4\uC5D0\uAC8C 5\uCD08 \uB3D9\uC548
      \uCD08\uB2F9 10\uC758 \uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915458
    m_Localized: "\uB9F9\uD654\uC720 \uD22C\uCC99 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915459
    m_Localized: "\uC131\uBB38 \uC55E\uC5D0 \uB9F9\uD654\uC720\uB97C \uBD80\uC5B4
      \uC131\uBB38 \uC55E\uC744 \uBD88\uBC14\uB2E4\uB85C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915460
    m_Localized: "\uC601\uC5ED \uB0B4\uC758 \uC801\uB4E4\uC5D0\uAC8C 50% \uD655\uB960\uB85C
      \uC810\uD654 \uC0C1\uD0DC \uC720\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915461
    m_Localized: "\uCC99\uC0B4 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915462
    m_Localized: "\uD55C \uB300\uC0C1\uC5D0\uAC8C \uC8FD\uC74C\uC758 \uD45C\uC2DD\uC744
      \uB0A8\uACA8 \uCC99\uC0B4 \uBA85\uB839\uC744 \uB0B4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915463
    m_Localized: "\uCC99\uC0B4 \uD45C\uC2DD\uC744 \uBC1B\uC740 \uC801\uC740 \uC8FC\uBCC0
      \uC758\uBCD1\uC73C\uB85C\uBD80\uD130 \uC6B0\uC120 \uACF5\uACA9 \uB300\uC0C1\uC774
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900436193280
    m_Localized: "\uD22C\uC11D \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776192
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uC5D0 \uD22C\uC11D \uC77C\uC81C
      \uC0AC\uACA9\uC744 \uBA85\uB839\uD574 \uC801 \uC9C4\uD615\uC744 \uC9D3\uC774\uAE34\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776193
    m_Localized: "\uC601\uC5ED \uB0B4 \uC801\uB4E4\uC5D0\uAC8C 20\uC758 \uB54C\uB9AC\uAE30
      \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776194
    m_Localized: "\uB1CC\uC6B0 \uC18C\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776195
    m_Localized: "\uC9C0\uC815\uD55C \uC601\uC5ED \uC704 \uD558\uB298\uC5D0\uC11C
      \uBCBC\uB77D\uC774 \uC21C\uCC28\uC801\uC73C\uB85C \uB099\uD558\uD55C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776196
    m_Localized: "6\uCD08 \uB3D9\uC548 1\uCD08\uB9C8\uB2E4 \uC601\uC5ED \uB0B4 \uBB34\uC791\uC704
      \uC801 1\uBA85\uC5D0\uAC8C 10\uC758 \uBC88\uAC1C \uB370\uBBF8\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776197
    m_Localized: "\uB9F9\uB3C5 \uC0B4\uD3EC \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776198
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uC5D0 \uB9F9\uB3C5\uC744 \uC0B4\uD3EC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776199
    m_Localized: "\uC601\uC5ED \uB0B4\uC758 \uC801\uB4E4\uC740 5\uCD08 \uB3D9\uC548
      50% \uD655\uB960\uB85C \uC911\uB3C5 \uC0C1\uD0DC \uC720\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776200
    m_Localized: "\uB36B \uC124\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776201
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uC5D0 \uB36B\uC744 \uC124\uCE58\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776202
    m_Localized: "\uB36B \uC791\uB3D9 \uC2DC \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uACB0\uBC15
      \uC0C1\uD0DC \uC720\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776203
    m_Localized: "\uC704\uCE58\uC0AC\uC218 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776204
    m_Localized: "\uC790\uB9AC\uB97C \uC9C0\uD0A4\uB294 \uBCD1\uC0AC\uB4E4\uC758
      \uBD88\uAD74\uC758 \uC758\uC9C0\uB97C \uC774\uB04C\uC5B4 \uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776205
    m_Localized: "\uC704\uCE58 \uC0AC\uC218\uD55C \uBAA8\uB4E0 \uC758\uBCD1\uB4E4\uC5D0\uAC8C
      \uBD88\uAD34 \uC0C1\uD0DC \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 21230694269763584
    m_Localized: "\uC9C4\uACA9 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 21230694290735104
    m_Localized: "\uC2B9\uBD80\uB97C \uC7AC\uCD09\uD558\uB294 \uC678\uCE68\uC73C\uB85C
      \uBCD1\uC0AC\uB4E4\uC774 \uC77C\uC81C\uD788 \uC9C4\uACA9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21230694290735105
    m_Localized: "\uC601\uC5ED \uB0B4\uC758 \uC758\uBCD1\uB4E4\uC5D0\uAC8C \uC2E0\uC18D\uAE30\uB3D9
      \uC0C1\uD0DC \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038151180288
    m_Localized: "\uC804\uB9AC\uD488 \uB178\uD68D"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374592
    m_Localized: "\uC8FD\uC740 \uBCD1\uC0AC\uB85C \uBD80\uD130 \uC54C\uB730\uD558\uAC8C
      \uAD70\uC790\uAE08\uC744 \uAE01\uC5B4 \uBAA8\uC740\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374593
    m_Localized: "\uC801 \uCC98\uCE58\uC2DC \uC5BB\uB294 \uAD70\uC790\uAE08\uC774
      20% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374594
    m_Localized: "\uAE08\uAC15\uC0B0\uB3C4 \uC2DD\uD6C4\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374595
    m_Localized: "\uCD08\uAE30 \uAD70\uC790\uAE08\uC744 200\uB0E5 \uC18C\uBAA8\uD558\uC5EC
      \uBAA8\uB4E0 \uC544\uAD70 \uBCD1\uC0AC\uB4E4\uC744 \uC798 \uBA39\uC774\uACE0
      \uC804\uD22C \uD22C\uC785\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374596
    m_Localized: "\uBAA8\uB4E0 \uC544\uAD70 \uBCD1\uC0AC\uB4E4\uC758 \uCD5C\uB300
      \uCCB4\uB825 20 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374597
    m_Localized: "\uBE44\uC7A5\uD55C \uCD9C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374598
    m_Localized: "\uCD9C\uC815 \uC2DC \uBE44\uC7A5\uD55C \uAC01\uC624\uB97C \uC5F0\uC124\uD558\uC5EC
      \uC758\uBCD1\uB4E4\uC758 \uD22C\uC9C0\uB97C \uC0C1\uC2B9\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374599
    m_Localized: "\uBAA8\uB4E0 \uC544\uAD70 \uBCD1\uC0AC\uB4E4\uC758 \uC2A4\uD0AC
      \uACF5\uACA9 \uB370\uBBF8\uC9C0\uAC00 5% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374600
    m_Localized: "\uC0C1\uAE09 \uC804\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374601
    m_Localized: "\uC0C1\uAE09 \uC804\uC220 \uD6C8\uB828\uC744 \uD1B5\uD574 \uBCD1\uC0AC\uB4E4\uC758
      \uC804\uD22C \uAE30\uC220\uC744 \uC219\uB828\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374602
    m_Localized: "\uBAA8\uB4E0 \uC544\uAD70 \uBCD1\uC0AC\uB4E4\uC758 \uACF5\uACA9
      \uC18D\uB3C4 10% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374603
    m_Localized: "\uC758\uBB34\uC18C \uC124\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374604
    m_Localized: "\uC815\uBE44\uD558\uB294 \uC2DC\uAC04\uC5D0 \uBCD1\uC0AC\uB4E4\uC744
      \uCE58\uB8CC\uD574 \uD68C\uBCF5\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25103038155374605
    m_Localized: "\uBC29\uC5B4 \uC644\uB8CC \uC2DC \uBAA8\uB4E0 \uC544\uAD70 \uBCD1\uC0AC\uB4E4\uC758
      \uCCB4\uB825 10% \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
