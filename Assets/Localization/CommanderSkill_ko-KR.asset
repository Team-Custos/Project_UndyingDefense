  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: 234f9521446a9de42815f2adc8111ea2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38428721152
    m_Localized: "\uC9D1\uC911 \uC0AC\uACA9 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915456
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uB85C \uC2E0\uD638\uB97C \uBCF4\uB0B4\uC5B4
      \uC77C\uC81C\uD788 \uD654\uC0B4\uC744 \uC3D8\uC544 5\uCD08 \uB3D9\uC548 \uD654\uB825\uC744
      \uC9D1\uC911\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915457
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC801, 1\uCD08\uB9C8\uB2E4 \uCC0C\uB974\uAE30
      \uB370\uBBF8\uC9C0 25"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915458
    m_Localized: "\uB9F9\uD654\uC720 \uD22C\uCC99 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915459
    m_Localized: "\uC57D\uC18D\uB41C \uC2E0\uD638\uB97C \uBCF4\uB0B4\uBA74 \uC131\uBB38
      \uC55E\uC5D0 \uB9F9\uD654\uC720 \uD56D\uC544\uB9AC\uB97C \uB358\uC838 \uC131\uBB38
      \uC55E\uC744 5\uCD08 \uB3D9\uC548 \uBD88\uBC14\uB2E4\uB85C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915460
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC801, 1\uCD08\uB9C8\uB2E4 \uBD88
      \uB370\uBBF8\uC9C0 25, '\uC810\uD654 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915461
    m_Localized: "\uCC99\uC0B4 \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 38432915462
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC801\uC5D0\uAC8C \uCD5C \uC6B0\uC120
      \uC21C\uC704 \uACF5\uACA9\uC758 \uD45C\uC2DD\uC744 \uD558\uC5EC \uCC99\uC0B4
      \uBA85\uB839\uC744 \uB0B4\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38432915463
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC801, \uCC99\uC0B4 \uD45C\uC2DD
      \uBD80\uC5EC, \uBC94\uC704 \uB0B4 \uC758\uBCD1\uC758 \uCD5C\uC6B0\uC120 \uACF5\uACA9
      \uB300\uC0C1\uC73C\uB85C \uC9C0\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900436193280
    m_Localized: "\uD22C\uC11D \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776192
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uB85C \uC2E0\uD638\uB97C \uBCF4\uB0B4\uC5B4
      \uCEE4\uB2E4\uB780 \uB3CC \uBB34\uB354\uAE30\uB97C \uD22C\uC11D\uD558\uAC8C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776193
    m_Localized: "\uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC801, \uB54C\uB9AC\uAE30 \uB370\uBBF8\uC9C0
      75, '\uAE30\uC808 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776194
    m_Localized: "\uCC9C\uB465\uAD6C\uB984 \uC18C\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776195
    m_Localized: "\uB3C4\uC220\uB85C \uC6B4\uAE30\uD558\uC5EC \uAD11\uBC94\uC704\uD558\uAC8C
      \uBC88\uAC1C\uB97C \uB0B4\uB9AC\uCE58\uB294 '\uCC9C\uB465\uAD6C\uB984'\uC744
      5\uCD08 \uB3D9\uC548 \uC18C\uD658\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776196
    m_Localized: "0.5\uCD08\uB9C8\uB2E4 \uC601\uC5ED \uB0B4 \uBB34\uC791\uC704 \uC801
      1\uBA85, \uBC88\uAC1C \uB370\uBBF8\uC9C0 25, '\uAC10\uC804 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776197
    m_Localized: "\uB9F9\uB3C5 \uC0B4\uD3EC \uBA85\uB839"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776198
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uB85C \uC2E0\uD638\uB97C \uBCF4\uB0B4\uC5B4
      \uB3C5\uC774 \uB2F4\uAE34 \uD56D\uC544\uB9AC\uB97C \uB358\uC838 5\uCD08 \uB3D9\uC548
      \uB9F9\uB3C5\uC9C0\uB300\uB97C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776199
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC801, 1\uCD08\uB9C8\uB2E4 \uB3C5
      \uB370\uBBF8\uC9C0 25, '\uC911\uB3C5 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776200
    m_Localized: "\uC120\uD48D \uCC38\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776201
    m_Localized: "\uC9C0\uD718\uAD00\uC774 \uBD80\uCC44\uB97C \uD718\uB458\uB7EC,
      \uB0A0\uCE74\uB85C\uC6B4 \uBC14\uB78C\uC758 \uAC80\uAE30\uB97C \uB0A0\uB824
      \uBCF4\uB0B8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776202
    m_Localized: "\uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC801, \uBCA0\uAE30 \uB370\uBBF8\uC9C0
      75"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776203
    m_Localized: "\uACF5\uD3EC\uC758 \uD1A0\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776204
    m_Localized: "5\uCD08\uB3D9\uC548 \uC720\uC9C0\uB418\uB294 \uC7A5\uC2B9\uC744
      \uC138\uC6CC \uBD80\uC815\uD55C \uC801\uB4E4\uB85C \uD558\uC5EC\uAE08 \uB450\uB824\uC6C0\uC5D0
      \uD729\uC2F8\uC774\uAC8C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15005900448776205
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC801, 1\uCD08\uB9C8\uB2E4 '\uC704\uCD95
      \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 21230694269763584
    m_Localized: "\uD638\uAD6D\uC758 \uC2E0\uAD11"
    m_Metadata:
      m_Items: []
  - m_Id: 21230694290735104
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC774 \uC9C0\uB2CC \uD638\uAD6D\uC758\uC9C0\uB97C
      \uC9D1\uC911\uC2DC\uCF1C \uC2E0\uAD11\uC744 \uBC1C\uD558\uB2C8 \uC801\uC758
      \uACF5\uACA9\uC774 \uBB34\uC6A9\uD574\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 21230694290735105
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC544\uAD70, '\uBD88\uAD34 \uC0C1\uD0DC'
      \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267794907136
    m_Localized: "\uD30C\uBA78\uC758 \uC8FC\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490048
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC801\uC744 \uD5A5\uD574 \uD30C\uBA78\uC758
      \uBD80\uC801\uC744 \uB0A0\uB824, \uBD88\uAE38\uD55C \uAE30\uBD84\uC744 \uC99D\uD3ED\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490049
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC801, '\uC704\uCD95 \uC0C1\uD0DC'
      \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490050
    m_Localized: "\uC804\uC124\uC758 \uC9C0\uD718\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490051
    m_Localized: "10\uCD08\uB3D9\uC548 \uC720\uC9C0\uB418\uB294 \uC9C0\uD718\uAD00
      \uC0C1\uC9D5 \uAE43\uBC1C\uC744 \uC138\uC6CC \uC8FC\uBCC0 \uBCD1\uC0AC\uB4E4\uC758
      \uD22C\uC9C0\uC640 \uD65C\uB825\uC744 \uB192\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490052
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC544\uAD70, '\uD22C\uC9C0 \uC0C1\uC2B9
      \uC0C1\uD0DC' \uBD80\uC5EC, 1\uCD08\uB9C8\uB2E4 \uCCB4\uB825 5 \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490053
    m_Localized: "\uC9C4\uACA9 \uC800\uC9C0 \uC791\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490054
    m_Localized: "\uAE38\uBAA9\uC5D0 5\uCD08\uB3D9\uC548 \uC720\uC9C0\uB418\uB294
      \uB9C8\uB984\uC1E0\uB97C \uD769\uBFCC\uB824 \uB193\uC544 \uC9C0\uB098\uAC00\uB294
      \uC801\uB4E4\uC758 \uC774\uB3D9\uB825\uC744 \uD604\uC800\uD788 \uAC10\uC18C\uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490055
    m_Localized: "\uC601\uC5ED \uB0B4 \uBAA8\uB4E0 \uC801, \uC774\uB3D9 \uC18D\uB3C4
      50% \uAC10\uC18C, 1\uCD08\uB9C8\uB2E4 \uACE0\uC815 \uB370\uBBF8\uC9C0 15"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490056
    m_Localized: "\uAC15\uCCA0\uB36B \uB9E4\uC124"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490057
    m_Localized: "\uC9C0\uC2DC\uD55C \uC704\uCE58\uC5D0 \uAC15\uB825\uD55C \uCC30\uCF54\uD615
      \uB36B\uC744 \uC124\uCE58\uD55C\uB2E4. \uBA67\uB3FC\uC9C0\uB3C4 \uC7A1\uC744
      \uC815\uB3C4\uB77C\uACE0 \uD55C\uB2E4. \uCD5C\uB300 3\uAC1C \uC124\uCE58 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490058
    m_Localized: "\uC791\uB3D9 \uC2DC \uC801 \uB2E8\uC77C \uB300\uC0C1, \uACE0\uC815
      \uB370\uBBF8\uC9C0 35, '\uACB0\uBC15 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490059
    m_Localized: "\uB3C4\uD654 \uC0BC\uB9E4\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490060
    m_Localized: "\uD2B9\uC815 \uAD6C\uC5ED\uC5D0 \uB3C4\uD654\uB97C \uBFCC\uB824
      \uC758\uBCD1\uB4E4\uC758 \uBD80\uC815\uD55C \uB9C8\uC74C\uC744 \uC815\uD654\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490061
    m_Localized: "\uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC544\uAD70, \uBD80\uC815 \uC0C1\uD0DC
      \uD574\uC81C, '\uC9D1\uC911 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490062
    m_Localized: "\uBE44\uACA9\uC9C4\uCC9C\uB8B0"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490063
    m_Localized: "\uBE44\uACA9\uC9C4\uCC9C\uB8B0\uB97C \uC0AC\uC6A9, \uACA8\uB0E5\uD55C
      \uC9C0\uC810\uC5D0 \uAC15\uB825\uD55C \uC720\uD0C4\uC744 \uBC1C\uC0AC\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490064
    m_Localized: "\uBC94\uC704 \uB0B4 \uBAA8\uB4E0 \uC801, \uACE0\uC815 \uB370\uBBF8\uC9C0
      90"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490065
    m_Localized: "\uC791\uC5F4\uC758 \uBD88\uD654\uC0B4"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490066
    m_Localized: "\uC9C0\uD718\uAD00\uC774 \uBAA9\uD45C\uBB3C\uC5D0 \uBD88\uD654\uC0B4\uC744
      \uC3D8\uC544 \uC791\uC5F4\uD558\uAC8C \uB9CC\uB4E4\uACE0 \uC8FC\uBCC0\uC5D0
      \uC62E\uACA8\uBD99\uAC8C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490067
    m_Localized: "\uC9C0\uC815 \uB300\uC0C1\uC758 \uC801, \uCC0C\uB974\uAE30 \uB370\uBBF8\uC9C0
      75, '\uC791\uC5F4 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490068
    m_Localized: "\uC9C4\uACA9\uC758 \uC18C\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490069
    m_Localized: "\uBE60\uB974\uACE0 \uC7A5\uC5C4\uD55C \uAD70\uC545\uC73C\uB85C,
      \uC758\uBCD1\uB4E4\uC758 \uC0AC\uAE30\uAC00 \uC624\uB974\uACE0 \uC77C\uC0AC\uBD84\uB780\uD558\uAC8C
      \uB3CC\uACA9\uD558\uAC8C \uB9CC\uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 86444267807490070
    m_Localized: "\uC804\uC7A5\uC758 \uBAA8\uB4E0 \uC544\uAD70, '\uD22C\uC9C0 \uC0C1\uC2B9
      \uC0C1\uD0DC'\uC640 '\uC2E0\uC18D\uAE30\uB3D9 \uC0C1\uD0DC' \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
