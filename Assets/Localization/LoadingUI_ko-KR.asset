  m_SharedData: {fileID: 11400000, guid: e6daa5837f655424db01a3cf29a778d5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 85698592768
    m_Localized: "\uAD50\uC804\uC774 \uC6B0\uC120\uC778 \uCE68\uB7B5\uC790\uB294
      \uC758\uBCD1\uC744 \uCD5C\uC6B0\uC120\uC801\uC73C\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175680
    m_Localized: "\uAC15\uB825\uD55C \uC758\uBCD1 \uD55C\uBA85\uC774\uB0D0 \uC5EC\uB7EC\uBA85\uC758
      \uAE30\uCD08 \uC758\uBCD1\uC774\uB0D0 \uC120\uD0DD\uC740 \uC9C0\uD718\uAD00\uC758
      \uBC29\uC5B4\uC804\uB7B5\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175681
    m_Localized: "\uC9C0\uD718\uAD00 \uC2A4\uD0AC\uC744 \uC801\uC808\uD558\uAC8C
      \uC6B4\uC6A9\uD55C\uB2E4\uBA74 \uC704\uD0DC\uB85C\uC6B4 \uC0C1\uD669\uC744
      \uBAA8\uBA74\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175682
    m_Localized: "\uCC98\uC74C \uBC30\uCE58\uB41C \uC758\uBCD1 \uC720\uB2DB\uC740
      \uC704\uCE58 \uC0AC\uC218 \uBAA8\uB4DC\uB85C \uCE68\uB7B5\uC790\uC758 \uC774\uB3D9\uC744
      \uB9C9\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC801\uC808\uD788 \uBC30\uCE58\uD558\uC5EC
      \uC801\uB4E4\uC758 \uB3D9\uC120\uC744 \uC804\uB7B5\uC801\uC73C\uB85C \uC81C\uC5B4\uD574\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175683
    m_Localized: "\uC790\uC720 \uC804\uD22C \uBAA8\uB4DC\uC778 \uC758\uBCD1 \uC720\uB2DB\uC740
      \uCE68\uB7B5\uC790\uB97C \uCD94\uACA9\uD558\uC5EC \uACF5\uACA9\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175684
    m_Localized: "\uB2E8\uCD95\uD0A4 1, 2, 3, 4\uBC88\uC744 \uD65C\uC6A9\uD574 \uC6D0\uD558\uB294
      \uC758\uBCD1\uC744 \uBE60\uB974\uAC8C \uBAA8\uC9D1\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175685
    m_Localized: "\uC9C0\uD718\uAD00 \uC2A4\uD0AC \uCC3D\uC5D0\uC11C \uC9C0\uD718\uAD00
      \uC2A4\uD0AC\uC744 \uCD5C\uB300 3\uAC1C\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC
      \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175686
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC6E8\uC774\uBE0C\uB294 \uBCF4\uC2A4\uC640
      \uCE68\uB7B5\uC790\uB4E4\uC774 \uC804\uB825\uC744 \uB2E4\uD574 \uBAB0\uB824\uC635\uB2C8\uB2E4.
      \uD6A8\uC728\uC801\uC778 \uBC30\uCE58\uC640 \uCC38\uC2E0\uD55C \uC804\uB7B5\uC73C\uB85C
      \uC804\uD22C\uB97C \uC2B9\uB9AC\uB85C \uC774\uB04C\uC5B4\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 85711175687
    m_Localized: "\uCE68\uB7B5\uC790\uB4E4\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C \uC131\uC744
      \uACF5\uACA9\uD558\uB824 \uD558\uC9C0\uB9CC, \uAE38\uC774 \uB9C9\uD600 \uC131\uC73C\uB85C
      \uC811\uADFC\uD560 \uC218 \uC5C6\uB2E4\uBA74 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
      \uC758\uBCD1\uC744 \uACF5\uACA8\uD558\uB2C8 \uC8FC\uC758\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 85711175688
    m_Localized: "\uC758\uBCD1\uB4E4\uC740 \uBAA8\uB4DC\uB97C \uC804\uD658\uD558\uAC70\uB098
      \uC2B9\uAE09\uD560 \uB54C \uC77C\uC815 \uC2DC\uAC04\uC774 \uC18C\uC694\uB429\uB2C8\uB2E4.
      \uC774 \uB54C\uB294 \uC5B4\uB5A0\uD55C \uC870\uC791\uC774\uB098 \uACF5\uACA9\uB3C4
      \uB418\uC9C0 \uC54A\uC73C\uB2C8 \uC2E0\uC911\uD558\uAC8C \uC0AC\uC6A9\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 85711175689
    m_Localized: "\uC720\uB2DB\uC758 \uB4F1\uAE09\uC774 \uB192\uC744\uC218\uB85D
      \uB2A5\uB825\uCE58\uAC00 \uAC15\uB825\uD558\uACE0 \uAC15\uB825\uD55C \uC2A4\uD0AC\uC744
      \uBCF4\uC720\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175690
    m_Localized: "\uBC29\uC5B4 \uC18D\uC131\uC774 \uC644\uCDA9\uAC11\uC778 \uC720\uB2DB\uC740
      \uB54C\uB9AC\uAE30 \uACF5\uACA9 \uC18D\uC131\uC5D0 \uD53C\uD574\uB97C \uB35C
      \uBC1B\uACE0 \uCE58\uBA85\uD0C0\uAC00 \uD130\uC9C8 \uD655\uB960\uC744 \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175691
    m_Localized: "\uBC29\uC5B4 \uC18D\uC131\uC774 \uBC29\uD0C4\uAC11\uC778 \uC720\uB2DB\uC740
      \uCC0C\uB974\uAE30 \uACF5\uACA9 \uC18D\uC131\uC5D0 \uD53C\uD574\uB97C \uB35C
      \uBC1B\uACE0 \uCE58\uBA85\uD0C0\uAC00 \uD130\uC9C8 \uD655\uB960\uC744 \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175692
    m_Localized: "\uBC29\uC5B4 \uC18D\uC131\uC774 \uCCA0\uAC11\uC778 \uC720\uB2DB\uC740
      \uBCA0\uAE30 \uACF5\uACA9 \uC18D\uC131\uC5D0 \uD53C\uD574\uB97C \uB35C \uBC1B\uACE0
      \uCE58\uBA85\uD0C0\uAC00 \uD130\uC9C8 \uD655\uB960\uC744 \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175693
    m_Localized: "\uC0C1\uD0DC \uC911 \uC911\uCCA9\uC774 \uB418\uB294 \uC0C1\uD0DC\uAC00
      \uC874\uC7AC\uD569\uB2C8\uB2E4. \uC0C1\uD0DC\uAC00 4\uBC88 \uC911\uCCA9\uB418\uBA74
      \uAC15\uD654\uB41C \uC0C1\uD0DC \uD6A8\uACFC\uAC00 \uBC1C\uB3D9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175694
    m_Localized: "\uC9C0\uD718\uAD00 \uC2B9\uAE09\uC744 \uD558\uBA74 \uB354 \uB9CE\uC740
      \uC9C0\uD718\uAD00 \uC2A4\uD0AC\uC744 \uD574\uAE08\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uACF5\uD6C8\uB3C4\uB97C
      \uC313\uC544 \uC6D0\uD558\uB294 \uC9C0\uD718\uAD00 \uC2A4\uD0AC\uC744 \uC120\uD0DD\uD574
      \uC804\uD22C\uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 85711175695
    m_Localized: "\uC870\uC2EC\uD558\uC138\uC694! \uC790\uD3ED \uC720\uB2DB\uC740
      \uCCB4\uB825\uC774 10% \uC774\uD558\uAC00 \uB418\uBA74 \uD3ED\uBC1C\uD558\uC5EC
      \uC8FC\uBCC0\uC5D0\uAC8C \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175696
    m_Localized: "\uC804\uD22C\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74 \uC804\uD22C
      \uC2DC\uAC04\uC774 \uAE30\uB85D\uB429\uB2C8\uB2E4. \uCC38\uC2E0\uD55C \uC804\uB7B5\uC744
      \uD65C\uC6A9\uD574 \uC2E0\uAE30\uB85D\uC744 \uB2EC\uC131\uD574\uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 85711175697
    m_Localized: "\uC778\uBB3C \uB3C4\uAC10 \uCC3D\uC5D0\uC11C \uC804\uD22C \uC911
      \uB9CC\uB09C \uCE68\uB7B5\uC790\uB4E4\uC758 \uC815\uBCF4\uB97C \uD655\uC778\uD558\uC2E4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 85711175698
    m_Localized: "\uC8FC\uC758\uD558\uC138\uC694! \uC804\uD22C \uB3C4\uC911 \uC804\uC7A5\uC744
      \uC774\uD0C8\uD558\uBA74 \uC9C4\uD589 \uC911\uC778 \uC804\uD22C \uAE30\uB85D\uC740
      \uC800\uC7A5\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
