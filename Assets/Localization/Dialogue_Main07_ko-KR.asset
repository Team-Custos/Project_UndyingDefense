  m_TableData:
  - m_Id: 7885864960
    m_Localized: "\uB0A8\uC6D0\uC74D\uC5D0\uC11C \uC628 \uAE09\uD55C \uC804\uAC08\uC785\uB2C8\uB2E4.
      \uD30C\uC8FD\uC9C0\uC138\uB85C \uBC00\uACE0\uB4E4\uC5B4\uC624\uB294 \uCE68\uB7B5\uC790\uB4E4\uC758
      \uBC1C\uAC78\uC74C\uC744 \uB2A6\uCD94\uC5B4\uC57C \uD55C\uB2E4\uBA70 \uC804\uB77C\uBCD1\uC0AC\uAED8\uC11C
      \uC9C0\uC6D0\uC744 \uC694\uCCAD\uD558\uC168\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10939318272
    m_Localized: "\uB0A8\uC6D0\uC740 \uC804\uB77C\uB3C4\uC640 \uCDA9\uCCAD\uB3C4\uB85C
      \uC9C4\uAD70\uD558\uB294 \uC694\uCDA9\uC9C0\uC774\uACE0 \uAC70\uAE30\uAC00
      \uB6AB\uB9AC\uBA74 \uAC89\uC7A1\uC744 \uC218 \uC5C6\uC774 \uBC29\uBC29\uACE1\uACE1\uC774
      \uCD08\uD1A0\uD654 \uB420 \uAC83\uC774\uB77C \uACB0\uC0AC\uC758 \uAC01\uC624\uB85C
      \uC9C4\uC744 \uAD6C\uCD95\uD558\uACE0 \uC788\uC0AC\uC628\uB370,"
    m_Metadata:
      m_Items: []
  - m_Id: 13858553856
    m_Localized: "\uB73B\uC788\uB294 \uAC00\uBB38\uC5D0\uC11C\uB294 \uC790\uC9C4\uD574\uC11C
      \uAD70\uB7C9\uBBF8\uAE4C\uC9C0 \uB9C8\uB828\uD558\uC5EC \uC218\uB808\uC5D0
      \uC2E3\uACE0 \uBAA8\uC5EC\uB4E4\uACE0 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4.
      \uCC38\uC73C\uB85C \uADF8 \uC758\uAE30\uC5D0 \uC219\uC5F0\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 17247551488
    m_Localized: "\uADF8\uB7F0 \uC640\uC911\uC5D0 \uD30C\uACAC\uC744 \uC628 \uBA85\uC758
      \uC7A5\uC218\uAC00 \uC758\uACAC\uC774 \uB9DE\uC9C0 \uC54A\uC544 \uC0B0\uC131\uACFC
      \uC74D\uC131\uC744 \uB450\uACE0 \uC124\uC655\uC124\uB798 \uD558\uB294 \uC911\uC774\uB77C\uB294\uB370,
      \uD0C1\uC6D4\uD55C \uBCD1\uBC95\uC758 \uC7A5\uAD70\uC774 \uAC00\uC11C \uC880
      \uC815\uB9AC\uD574\uC8FC\uC2DC\uBA74 \uC548\uB418\uACA0\uC2B5\uB2C8\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
