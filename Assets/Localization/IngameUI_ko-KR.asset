  m_TableData:
  - m_Id: 61207986176
    m_Localized: "\uB300\uB2E8\uD569\uB2C8\uB2E4!\n\uB2F9\uC2E0\uC758 \uD0C1\uC6D4\uD55C
      \uC9C0\uD718 \uB355\uBD84\uC5D0 \uCE68\uB7B5\uC790\uB97C \uBB3C\uB9AC\uCCE4\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 61216374784
    m_Localized: "\uC548\uD0C0\uAE5D\uC2B5\uB2C8\uB2E4.\n\uD63C\uC2E0\uC744 \uB2E4\uD574
      \uBD84\uC804\uD588\uC9C0\uB9CC \uACB0\uAD6D \uD328\uD558\uACE0 \uB9D0\uC558\uC2B5\uB2C8\uB2E4."
