  m_SharedData: {fileID: 11400000, guid: 7db57416b35f9494a97aced3689e4d24, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 23987798016
    m_Localized: "\"\uC7A5\uAD70\uC758 \uBB34\uC6A9\uB2F4\uC774 \uBC8C\uC368 \uC18C\uBB38\uC774\uB77C\uB3C4
      \uB09C \uAC83\uC77C\uAE4C\uC694? \n\uC21C\uCC3D\uC758 \uB355\uACC4\uAC70\uC0AC\uB77C\uB294
      \uBD84\uAED8\uC11C \uC9C0\uC6D0\uC694\uCCAD\uC744 \uD574\uC624\uC168\uC2B5\uB2C8\uB2E4.
      \uB4E4\uC740 \uB0B4\uC6A9\uC740 \uC774\uB7EC\uD569\uB2C8\uB2E4.\""
    m_Metadata:
      m_Items: []
  - m_Id: 27431321600
    m_Localized: "\"\"\"\uB098\uB294 \uAD00\uC9C1\uC744 \uB0B4\uB824\uB193\uACE0
      \uC138\uC0C1 \uC774\uCE58\uB97C \uACF5\uBD80\uD558\uB358 \uC774\uB984\uC5C6\uB294
      \uD559\uC790\uC77C \uBFD0\uC774\uC9C0\uB9CC,\n\uC704\uD0DC\uB85C\uC6B4 \uC9C0\uACBD\uC774\uB77C
      \uC774\uB807\uAC8C \uADF8\uB300\uC5D0\uAC8C \uBD93\uC744 \uB4E4\uC5B4 \uC804\uD558\uAC8C
      \uB418\uC5C8\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 30430248960
    m_Localized: "\"\uC0C1\uC11C\uB86D\uC9C0 \uBABB\uD55C \uC815\uC138\uC5D0 \uCC9C\uBB38\uC744
      \uC0B4\uD53C\uACE0 \uADC0\uD5A5\uD558\uC5EC \uB300\uBE44\uD558\uB358 \uC911
      \uC804\uB780\uC774 \uBC1C\uBC1C\uD558\uB2C8\n\uCDA9\uCCAD\uC758 \uACE0\uBA85\uD55C
      \uD559\uC790\uBD84 \uD718\uD558\uC5D0 \uC9D1\uACB0\uD574 \uAE08\uC0B0\uC5D0
      \uC9C4\uC744 \uCE58\uAE30\uB85C\uD558\uC5EC \uAC70\uAE30 \uD569\uB958\uD558\uB294
      \uAE38\uC774\uC624.\""
    m_Metadata:
      m_Items: []
  - m_Id: 33789886464
    m_Localized: "\"\uB4E3\uAE30\uB85C \uADF8\uB300\uC758 \uBCD1\uBC95\uC774 \uCD9C\uC911\uD558\uB2E4
      \uD558\uB2C8 \uAC04\uACE1\uD788 \uBC14\uB77C\uAC74\uB370, \n\uAC00\uB2A5\uD558\uB2E4\uBA74
      \uAE08\uC0B0\uC73C\uB85C \uC640 \uC6B0\uB9AC\uC758 \uACB0\uC758\uC5D0 \uC2B9\uB9AC\uC758
      \uAE30\uC6B4\uC744 \uBCF4\uD0DC\uC8FC\uC2DC\uC624.\"\"\""
    m_Metadata:
      m_Items: []
  - m_Id: 37514428416
    m_Localized: "\uC774\uB807\uAC8C \uC804\uD558\uB77C \uD558\uC600\uC2B5\uB2C8\uB2E4.
      \uC0C1\uD669\uC774 \uAE09\uBC15\uD55C\uAC83 \uAC19\uC73C\uB2C8 \uC7A5\uAD70\uAED8\uC11C
      \uC6A9\uB2E8\uC744 \uB0B4\uB824 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
