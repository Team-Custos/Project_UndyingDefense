  m_TableData:
  - m_Id: 37308841984
    m_Localized: "\uB2E4\uC2DC \uD55C\uBC88, \uC758\uB85C\uC6B4 \uC77C\uC5D0 \uC55E\uC7A5\uC11C
      \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC57D\uC18D\uB4DC\uB9B0
      \uB300\uB85C \uC800\uB3C4 \uC131\uC2EC\uAECF \uBCF4\uC88C\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37313036288
    m_Localized: "\uC5B4\uB835\uAC8C \uCD9C\uC804\uC744 \uACB0\uC2EC\uD558\uC168\uC744
      \uD150\uB370... \uC900\uBE44 \uC5C6\uC774 \uC804\uC7A5\uC5D0 \uB6F0\uC5B4\uB4E4
      \uC21C \uC5C6\uACA0\uC9C0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 37313036289
    m_Localized: "\uADF8\uB798\uC11C \uB9C8\uB828\uD588\uC2B5\uB2C8\uB2E4. \uC804\uC7A5\uC5D0\uC11C
      \uC9C0\uD718\uD558\uB294 \uC694\uB839\uC744 \uC775\uD788\uC2E4 \uC218 \uC788\uB294
      \uBAA8\uC758\uC804\uD22C \uD6C8\uB828\uC7A5\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 37317230592
    m_Localized: "\uD6C8\uB828\uC7A5\uC5D0 \uC785\uC7A5\uD558\uAE30 \uC804, \uC124\uC815\uC5D0
      \uBE44\uCE58\uD574 \uB454 \uC804\uD22C \uC9C0\uCE68\uC11C(\uC804\uC220 \uAD50\uBCF8)\uB97C
      \uD655\uC778\uD574 \uB450\uC2DC\uBA74 \uB3C4\uC6C0\uC774 \uB420 \uAC81\uB2C8\uB2E4."
