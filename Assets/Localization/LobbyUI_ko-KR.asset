      m_Items: []
  - m_Id: 76069863934935040
    m_Localized: "\uAD6C\uAE00\uD3FC\uC5D0 \uC791\uC131\uD55C \uB0B4\uC6A9\uC740
      \uAC8C\uC784 \uAC1C\uBC1C\uC790\uC5D0\uAC8C \uC9C1\uC811 \uC804\uB2EC\uB429\uB2C8\uB2E4."
