  - m_Id: 38147702784
    m_Localized: Unknown Officer
    m_Metadata:
      m_Items: []
  - m_Id: 38172868608
    m_Localized: Proclamation
    m_Metadata:
      m_Items: []
  - m_Id: 38177062912
    m_Localized: "From ages past, people have risen in times of peril\n When the
      nation faces ruin,\n those who stand in righteous anger and take up arms\n
      embody the law of coexistence and the foundation of a true nation\n \n Upon
      reading this proclamation, let none remain idle\n Rally the people, form your
      ranks,\n and deliver the people of this land from despair"
    m_Metadata:
      m_Items: []
