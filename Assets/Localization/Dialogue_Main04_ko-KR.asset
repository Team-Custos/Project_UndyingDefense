  m_TableData:
  - m_Id: 29201252352
    m_Localized: "\uBC29\uAE08 \uB4E4\uC5B4\uC628 \uC804\uAC08\uC785\uB2C8\uB2E4.
      \uC774\uC870\uD310\uC11C \uCD5C\uBA85\uAE38\uAED8\uC11C \uC9C1\uC811 \uC9C0\uC6D0\uC744
