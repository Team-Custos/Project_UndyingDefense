  m_TableData:
  - m_Id: 37308841984
    m_Localized: Once again, thank you for standing with this righteous cause. As
      promised, I will serve you with all my heart.
    m_Metadata:
      m_Items: []
  - m_Id: 37313036288
    m_Localized: It must have taken courage to choose battle... but we cannot rush
      into war unprepared.
    m_Metadata:
      m_Items: []
  - m_Id: 37313036289
    m_Localized: 'So I prepared this: a boot camp where you can practice commanding
      troops in a mock battle.'
    m_Metadata:
      m_Items: []
