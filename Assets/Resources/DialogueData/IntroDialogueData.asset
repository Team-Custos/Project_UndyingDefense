  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9dfbe4b30c82eb498a43686e132eb44, type: 3}
  m_Name: IntroDialogueData
  m_EditorClassIdentifier: 
  lines:
  - speakerName: 
    text: "\uB098\uC73C\uB9AC, \uACA9\uBB38\uC744 \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
  - speakerName: 
    text: "\uAC04\uCCAD\uD558\uC624\uB2C8 \uC800\uD76C\uB97C \uC774\uB044\uB294 \uC9C0\uD718\uAD00\uC774
      \uB418\uC5B4\uC8FC\uC2ED\uC2DC\uC624."
  - speakerName: 
    text: "\uB098\uC73C\uB9AC\uC758 \uC758\uB85C\uC6C0\uACFC \uCD1D\uBA85\uD568,
      \uC804\uC220\uC758 \uD574\uBC15\uD568\uC774 \uC628 \uC0AC\uBC29\uC5D0 \uC790\uC790\uD558\uB2C8,
      \uC801\uC784\uC790\uAC00 \uC544\uB2C8\uC2E4 \uC218 \uC5C6\uC0AC\uC635\uB2C8\uB2E4."
  - speakerName: 
    text: "\uC758\uBCD1\uB4E4 \uBAA8\uB450 \uB098\uC73C\uB9AC\uC758 \uBA85\uC744
      \uBC1B\uB4E4\uC5B4 \uC2F8\uC6B0\uAE30\uB97C \uBAA9\uB193\uC544 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC0AC\uC635\uB2C8\uB2E4. \uC800\uD76C\uC758 \uB0AF\uC744 \uBCF4\uC544\uC11C\uB77C\uB3C4
      \uAF2D \uC0DD\uAC01\uD574\uC8FC\uC2ED\uC2DC\uC624."
  - speakerName: 
    text: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC758 \uCCAD\uC744 \uBC1B\uC544\uB4E4\uC5EC
      \uCD9C\uC0AC\uD45C\uB97C \uC4F0\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
