%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9dfbe4b30c82eb498a43686e132eb44, type: 3}
  m_Name: IngameDialogueData
  m_EditorClassIdentifier: 
  lines:
  - speakerName: 
    text: "\uC544\uB2C8, \uCC98\uC74C\uC774 \uB9DE\uC73C\uC2ED\uB2C8\uAE4C? \uC774\uB807\uAC8C
      \uC804\uC220\uC744 \uAE30\uAC00 \uB9C9\uD788\uAC8C \uC775\uD788\uB294 \uBD84\uC740
      \uCC98\uC74C \uBD05\uB2C8\uB2E4!"
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC, \uC774\uBC88\uC5D4 \uD5C8\uC218\uC544\uBE44\uC600\uC9C0
      \uC54A\uC2B5\uB2C8\uAE4C! \uC2E4\uC804\uC5D0\uB294 \uC758\uBCD1\uB4E4\uC758
      \uADC0\uD55C \uBAA9\uC228\uC774 \uB2EC\uB824 \uC788\uC73C\uB2C8 \uC27D\uC9C0
      \uC54A\uC744 \uAC83\uC785\uB2C8\uB2E4.\n(\uC804\uC11C\uAD6C\uAC00 \uB0A0\uC544\uB4E0\uB2E4)"
  - speakerName: 
    text: "\uAE08\uC0B0\uC5D0\uC11C \uC628 \uC804\uAC08\uC774\uAD70\uC694. \uC9C0\uD718\uAD00
      \uB2D8\uAED8\uC11C \uC0B4\uD3B4\uBCF4\uC2DC\uC9C0\uC694."
  - speakerName: 
    text: "[\uAE08\uC0B0\uC73C\uB85C \uC801\uAD70\uC774 \uCCD0\uB4E4\uC5B4\uC624\uACE0
      \uC788\uB2E4\uB294 \uC18C\uC2DD \uB4E4\uC5C8\uC18C? \uB0B4 \uC758\uBCD1\uC744
      \uC774\uB04C\uACE0 \uCD9C\uBC1C\uD558\uB824 \uD588\uC73C\uB098, \uB098\uC758
      \uC804\uACF5\uC744 \uC2DC\uAE30\uD55C \uCDA9\uCCAD\uB3C4\uC21C\uCC30\uC0AC\uAC00
      \uC758\uBCD1\uB4E4\uC744 \uD574\uC0B0\uD574\uBC84\uB838\uC18C. \uB204\uAD6C\uB4E0
      \uBA3C\uC800 \uAE08\uC0B0\uC73C\uB85C \uAC00\uC904 \uC218 \uC788\uACA0\uC18C?
      \uB098\uB3C4 \uACE7 \uD569\uB958\uD558\uB9AC\uB2E4. (\uC758\uBCD1\uC7A5 \uC870\uD559\uC790
      \uBC30\uC0C1)]"
  - speakerName: 
    text: "\uAE08\uC0B0\uC774\uB77C\uBA74...! \uC544\uB9C8\uB3C4 \uC800\uD76C\uAC00
      \uAC00\uC7A5 \uBE68\uB9AC \uB3C4\uCC29\uD560 \uC218 \uC788\uACA0\uAD70\uC694."
  - speakerName: 
    text: " \uC544\uB2C8, \uC9C0\uAE08 \uBC14\uB85C \uAC00\uC2DC\uACA0\uB2E8 \uB9D0\uC500\uC774\uC2ED\uB2C8\uAE4C?
      \uC7A0\uC2DC\uB9CC \uAE30\uB2E4\uB9AC\uC2ED\uC2DC\uC624. (\uB4A4\uC801\uB4A4\uC801)"
  - speakerName: 
    text: " \uC5EC\uAE30, \uC804\uC220 \uC870\uC791\uC5D0 \uAD00\uD55C \uB0B4\uC6A9\uC785\uB2C8\uB2E4.
      \uC9C0\uD718\uAD00 \uB2D8\uC744 \uC704\uD574 \uC81C\uAC00 \uC774\uBBF8, \uBC8C\uC368,
      \uC5F4\uC2EC\uD788 \uC801\uC5B4\uB450\uC5C8\uC9C0\uC694."
  - speakerName: 
    text: "\uC124\uC815-\uAC8C\uC784\uC815\uBCF4\uC5D0 \uB4E4\uC5B4\uAC00\uC2DC\uBA74
      \uC5B8\uC81C\uB4E0\uC9C0 \uC0B4\uD3B4\uBCF4\uC2E4 \uC218 \uC788\uC73C\uB2C8
      \uAC71\uC815 \uBD99\uB4E4\uC5B4 \uB9E4\uC2ED\uC2DC\uC624!"
  - speakerName: 
    text: "\uC758\uBCD1\uACFC \uC801\uAD70\uC5D0 \uB300\uD55C \uC815\uBCF4\uB294
      \uC81C\uAC00 \uC0C1\uB2E8 \uCE90\uB9AD\uD130 \uB3C4\uAC10\uC5D0 \uC218\uC9D1\uD574\uB193\uC558\uC2B5\uB2C8\uB2E4.
      \uC804\uC220\uC5D0 \uD544\uC694\uD558\uC2E4 \uD130\uC774\uB2C8 \uB54C\uB54C\uB85C
      \uC0B4\uD3B4\uBD10\uC8FC\uC2ED\uC2DC\uC624."
  - speakerName: 
    text: "\uC774\uACF3\uC774 \uBC14\uB85C \uCCAB \uC804\uC7A5\uC785\uB2C8\uB2E4.
      \uBA3C \uAE38\uC774 \uB418\uACA0\uAD70\uC694. \uBB34\uC0AC\uD788 \uB3CC\uC544\uC624\uC2DC\uAE38
      \uBC14\uB77C\uACE0 \uC788\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uC774\uB9CC....!"
