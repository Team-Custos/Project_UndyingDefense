MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9dfbe4b30c82eb498a43686e132eb44, type: 3}
  m_Name: LobbyDialogueData
  m_EditorClassIdentifier: 
  lines:
  - speakerName: 
    text: "\uB098\uC73C\uB9AC, \uC544\uB2C8 \uC9C0\uD718\uAD00 \uB2D8. \uC18C\uC778\uC744
      \uBD80\uAD00\uC73C\uB85C \uC784\uBA85\uD574\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - speakerName: 
    text: "\uC7A0\uC2DC \uAD00\uAD70\uC758 \uC77C\uC744 \uB3C4\uC654\uB358 \uC774\uB825\uC744
      \uC54C\uC544\uBCF4\uC2DC\uACE0  \uB098\uB77C\uB97C \uC9C0\uD0A4\uB294 \uC77C\uC5D0
      \uC368\uC8FC\uC2DC\uB2E4\uB2C8\uC694!"
  - speakerName: 
    text: "\uB9C8\uCE68, \uD6C4\uD1F4\uD558\uB294 \uAD70\uC878\uB4E4\uC5D0\uAC8C
      \uB0C9\uD07C \uC0C1\uD669\uC744 \uBB3B\uACE0 \uC654\uC2B5\uB2C8\uB2E4. \uC548\uD0C0\uAE5D\uAC8C\uB3C4
      \uC804\uD669\uC774 \uC2EC\uC0C1\uCE58 \uC54A\uB2E4\uB294 \uC18C\uC2DD\uC785\uB2C8\uB2E4. "
  - speakerName: 
    text: "\uC804\uC5D0 \uC5C6\uC774 \uAC15\uB825\uD55C \uC678\uC778\uB4E4\uC774
      \uC870\uC120 \uAC01\uC9C0\uB97C \uACF5\uACA9\uD558\uACE0 \uC788\uB2E4\uACE0
      \uD569\uB2C8\uB2E4. \uADF8\uB4E4\uC744  \uC0C1\uB300\uD558\uB824\uBA74 \uC55E\uC73C\uB85C
      \uB9CE\uC740 \uAC83\uC744 \uC2A4\uC2A4\uB85C \uAE68\uC6B0\uCE58\uC154\uC57C
      \uD560 \uAC83\uC785\uB2C8\uB2E4."
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC \uAC71\uC815 \uB9C8\uC2ED\uC2DC\uC624! \uC774 \uBAB8\uC774
      \uC5F4\uACFC \uC131\uC744 \uB2E4\uD574 \uB3C4\uC6B8 \uD14C\uB2C8\uAE4C\uC694!"
  - speakerName: 
    text: "\uC544\uBB34\uB7F0 \uC900\uBE44 \uC5C6\uC774 \uC804\uC7A5\uC5D0 \uB6F0\uC5B4\uB4E4
      \uC21C \uC5C6\uACA0\uC9C0\uC694. \uBAA8\uC758 \uD6C8\uB828\uC744 \uD574\uBCFC\uAE4C\uC694?
      \uD6C8\uB828\uC7A5\uC5D0\uC11C \uC804\uC220 \uC9C0\uD718\uC758 \uAE30\uCD08\uB97C
      \uC2B5\uB4DD\uD574\uBCF4\uC2DC\uC9C0\uC694."
