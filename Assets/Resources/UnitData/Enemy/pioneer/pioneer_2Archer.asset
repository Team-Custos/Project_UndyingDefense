    \uADF8\uB7EC\uB098 '\uD30C\uC218\uAFBC'\uC774\uB77C\uB294 \uBA85\uCE6D\uC774
    \uC774\uB4E4\uC758 \uC0AC\uAE30\uB97C \uBD81\uB3CB\uC558\uB294\uC9C0 \uC790\uC138\uAC00
    \uC544\uC8FC \uC801\uADF9\uC801\uC774\uB2E4. \uC2E0\uC559\uC774 \uCDA9\uB9CC\uD55C
    \uADF8\uB4E4\uC740 \uC624\uB298\uB3C4 \uAD11\uAE30\uC758 \uD65C\uC744 \uC3D8\uC544\uBCF4\uB0B8\uB2E4."
