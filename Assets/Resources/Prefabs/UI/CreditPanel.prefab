  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nP.D.\n\uC870\uC778\uCCA0\n\nDev. Directing\n\uC870\uC778\uCCA0(CD& AD)
    \uAE40\uC900\uADDC(TD)\n\nProject Managing\n\uC774\uB2E4\uC740\n\nGame Design\n\uC774\uB2E4\uC740,
    \uCD5C\uC9C4\uC6C5, \uAE40\uC218\uC544\n\nProgramming\n\uAE40\uBCD1\uD604, \uC870\uC544\uC694,
    \uC1A1\uC8FC\uC724\n\nUI Design\n\uC57C\uC0DD\uC804\uC0AC, \uBC15\uAC15\uC601\n\nConcept
    Art\n\uBC31\uC11C\uC724, \uC774\uC11C\uC601\n\n3D Graphic Design\n\uAE40\uC131\uC9C4,
    \uB098\uCC2C\uBBFC, \uC784\uCE58\uD638, \uC774\uC8FC\uD658\n\nVFX Design\n\uAE40\uC131\uC9C4,
    \uAE40\uC900\uC11D, \uC2EC\uC218\uD604\n\nSound Design\n\uC57C\uC0DD\uC804\uC0AC\n\nMotion
    Concept\n\uC774\uB2E4\uC740\n\nQuality Assurance\n\uC815\uC7AC\uC6C5\n\n< \uC0AC\uC6A9
    Asset >\n\uCE68\uB7B5\uC790 \uBAA8\uB378\nBitgem\n\nVFX \uD6A8\uACFC\nKoreanTraditionalPattern_Effect,
    Zap VFX - Lightning Effects Pack\n\n\uC560\uB2C8\uBA54\uC774\uC158\nKevin Iglesias,
    Mixamo\n\nBGM Game Title\nMidnight(\u4E2D\u591C \uBC15\uC9C0\uD6C8)\n\nBGM Main
    Theme\noriental beat \uAC70\uBB38 (prod.TaWoo)\n\nBGM Battle Theme\nMYTH (Prod.
    TBW)\n\nA 2025 creation, powered by Custos Team"
